{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse",
  "version": "0.1.0",
  "identifier": "com.eclipse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eclipse",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sunshine", "binaries/moonlight"],
    "resources": ["resources/sunshine"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libavcodec60",
          "libva2",
          "pipewire",
          "libwayland-client0",
          "libqt6core6t64",
          "libqt6gui6t64",
          "libqt6widgets6t64",
          "libsdl2-2.0-0",
          "libsdl2-ttf-2.0-0"
        ]
      }
    }
  }
}
