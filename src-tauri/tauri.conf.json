{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse",
  "version": "0.1.0",
  "identifier": "com.eclipse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eclipse",
        "width": 1080,
        "height": 760,
        "minWidth": 420,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0f0f29"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "category": "Utility",
    "shortDescription": "Peer-to-peer remote desktop",
    "longDescription": "Every install is a symmetric node: this package is both a Sunshine host and a Moonlight client. NVIDIA NVENC uses the vendor GPU driver at runtime; the CUDA toolkit is not required to run Eclipse.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sunshine", "binaries/moonlight"],
    "resources": {
      "resources/sunshine": "share/sunshine",
      "resources/moonlight-runtime": "moonlight-runtime"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.1-0t64",
          "libgtk-3-0 | libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libcap2-bin",
          "pkexec",
          "libavcodec60 | libavcodec61",
          "libavformat60 | libavformat61",
          "libswscale7 | libswscale8",
          "libva2",
          "pipewire",
          "libwayland-client0",
          "libqt6core6t64 | libqt6core6",
          "libqt6gui6t64 | libqt6gui6",
          "libqt6widgets6t64 | libqt6widgets6",
          "libqt6qml6 | libqt6qml6t64",
          "libqt6quick6 | libqt6quick6t64",
          "libqt6svg6",
          "qml6-module-qtquick",
          "qml6-module-qtquick-controls",
          "qml6-module-qtquick-layouts",
          "qml6-module-qtquick-templates",
          "qml6-module-qtquick-window",
          "qml6-module-qtqml-workerscript",
          "libsdl2-2.0-0",
          "libsdl2-ttf-2.0-0",
          "libopus0",
          "libdrm2",
          "libevdev2",
          "libpulse0",
          "libx11-6",
          "libxrandr2",
          "libxtst6"
        ],
        "recommends": [
          "mesa-va-drivers",
          "intel-media-va-driver | intel-media-va-driver-non-free"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-eclipse-sunshine.rules": "../packaging/linux/60-eclipse-sunshine.rules",
          "/usr/lib/systemd/system/eclipse-host.service": "../packaging/linux/eclipse-host.service",
          "/usr/lib/modules-load.d/eclipse-uinput.conf": "../packaging/linux/eclipse-uinput.conf",
          "/usr/lib/eclipse/eclipse-hostctl": "../packaging/linux/eclipse-hostctl",
          "/usr/share/polkit-1/actions/com.eclipse.hostctl.policy": "../packaging/linux/com.eclipse.hostctl.policy",
          "/usr/share/polkit-1/rules.d/10-eclipse-host.rules": "../packaging/linux/10-eclipse-host.rules",
          "/etc/xdg/autostart/eclipse-tray.desktop": "../packaging/linux/eclipse-tray.desktop",
          "/usr/share/icons/hicolor/scalable/apps/eclipse.svg": "icons/eclipse.svg"
        },
        "postInstallScript": "../packaging/linux/postinst.sh",
        "postRemoveScript": "../packaging/linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2",
          "libcap",
          "polkit",
          "libavcodec-free",
          "libva",
          "pipewire-libs",
          "libwayland-client",
          "qt6-qtbase",
          "qt6-qtdeclarative",
          "qt6-qtsvg",
          "qt6-qtwayland",
          "SDL2",
          "SDL2_ttf",
          "opus",
          "libdrm",
          "libevdev",
          "pulseaudio-libs",
          "libX11",
          "libXrandr",
          "libXtst"
        ],
        "recommends": [
          "mesa-dri-drivers",
          "intel-media-driver"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-eclipse-sunshine.rules": "../packaging/linux/60-eclipse-sunshine.rules",
          "/usr/lib/systemd/system/eclipse-host.service": "../packaging/linux/eclipse-host.service",
          "/usr/lib/modules-load.d/eclipse-uinput.conf": "../packaging/linux/eclipse-uinput.conf",
          "/usr/lib/eclipse/eclipse-hostctl": "../packaging/linux/eclipse-hostctl",
          "/usr/share/polkit-1/actions/com.eclipse.hostctl.policy": "../packaging/linux/com.eclipse.hostctl.policy",
          "/usr/share/polkit-1/rules.d/10-eclipse-host.rules": "../packaging/linux/10-eclipse-host.rules",
          "/etc/xdg/autostart/eclipse-tray.desktop": "../packaging/linux/eclipse-tray.desktop",
          "/usr/share/icons/hicolor/scalable/apps/eclipse.svg": "icons/eclipse.svg"
        },
        "postInstallScript": "../packaging/linux/postinst.sh",
        "postRemoveScript": "../packaging/linux/postrm.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../packaging/windows/hooks.nsh"
      }
    }
  }
}
