 namespace platf {
   using namespace std::literals;
 
+  /**
+   * @brief Eclipse: PulseAudio server for the packaged root host service.
+   *
+   * The system unit has no session environment, so libpulse cannot find the
+   * desktop user's server and reports "Access denied". Use the native socket of
+   * the active seat0 user instead. Re-resolved on every stream, so it follows
+   * user switches.
+   *
+   * @return `unix:` server string, or empty for the libpulse default (not root,
+   *         `PULSE_SERVER` already set, or nobody logged in on seat0).
+   */
+  std::string eclipse_pulse_server() {
+    if (geteuid() != 0 || std::getenv("PULSE_SERVER") != nullptr) {
+      return {};
+    }
+    uid_t uid = 0;
+    if (sd_seat_get_active("seat0", nullptr, &uid) < 0 || uid == 0) {
+      return {};
+    }
+    const auto socket = "/run/user/"s + std::to_string(uid) + "/pulse/native";
+    struct stat st {};
+    if (stat(socket.c_str(), &st) != 0 || !S_ISSOCK(st.st_mode)) {
+      return {};
+    }
+    return "unix:"s + socket;
+  }
+
   /**
    * @brief Position mapping.
    */
