+  std::string eclipse_window_manager() {
+#ifdef _WIN32
+    return "Desktop Window Manager";
+#else
+    const char *hypr = eclipse_env("HYPRLAND_INSTANCE_SIGNATURE");
+    std::string desktop = eclipse_first_desktop(eclipse_env("XDG_CURRENT_DESKTOP"));
+    if (hypr || boost::iequals(desktop, "hyprland")) {
+      return "Hyprland (Wayland)";
