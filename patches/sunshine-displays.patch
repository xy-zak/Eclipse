+    auto names = kms_display_names(hwdevice_type);
+    std::vector<display_info_t> displays;
+    displays.reserve(names.size());
+    std::vector<std::pair<int, int>> sizes(names.size(), {0, 0});
+    for (auto &card_descriptor : kms::card_descriptors) {
+      for (auto &[_, monitor_descriptor] : card_descriptor.crtc_to_monitor) {
+        auto idx = monitor_descriptor.monitor_index;
+        if (idx < names.size()) {
+          sizes[idx] = {monitor_descriptor.viewport.width, monitor_descriptor.viewport.height};
+        }
+      }
+    }
+    for (size_t i = 0; i < names.size(); ++i) {
+      displays.push_back(display_info_t {names[i], sizes[i].first, sizes[i].second, i == 0});
