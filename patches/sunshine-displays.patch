+  /**
+   * @brief Enumerate Wayland outputs with physical current-mode size.
+   */
+  std::vector<platf::display_info_t> wl_display_info() {
+    std::vector<platf::display_info_t> displays;
+
+    wl::display_t display;
+    if (display.init()) {
+      return {};
+    }
+
+    wl::interface_t interface;
+    interface.listen(display.registry());
+
+    display.roundtrip();
+
+    if (!interface[wl::interface_t::XDG_OUTPUT] || !interface[wl::interface_t::WLR_EXPORT_DMABUF]) {
+      return {};
+    }
+
+    for (auto &monitor : interface.monitors) {
+      monitor->listen(interface.output_manager);
+    }
+
+    display.roundtrip();
+
+    for (int x = 0; x < interface.monitors.size(); ++x) {
+      auto monitor = interface.monitors[x].get();
+      platf::display_info_t info;
+      info.name = monitor->name.empty() ? std::to_string(x) : monitor->name;
+      info.width = monitor->viewport.width;
+      info.height = monitor->viewport.height;
+      info.primary = x == 0;
+      displays.emplace_back(std::move(info));
+    }
+
+    return displays;
+  }
+
 }  // namespace platf
