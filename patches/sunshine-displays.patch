+  void getDisplays(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) {
+      return;
+    }
+
+    print_req(request);
+
+    nlohmann::json output_tree;
+    output_tree["status"] = true;
+    nlohmann::json displays = nlohmann::json::array();
+    const auto info = platf::display_info(platf::mem_type_e::unknown);
+    for (size_t i = 0; i < info.size(); ++i) {
+      nlohmann::json item;
+      item["index"] = i;
+      item["name"] = info[i].name;
+      item["width"] = info[i].width;
+      item["height"] = info[i].height;
+      item["focused"] = info[i].primary;
+      displays.push_back(std::move(item));
+    }
+    output_tree["os"] = eclipse_os_pretty();
+    output_tree["windowManager"] = eclipse_window_manager();
+    output_tree["displays"] = std::move(displays);
+    send_response(response, output_tree);
+  }
