+      if (!desktop.empty() && !boost::iequals(desktop, "wayland")) {
+        return desktop + " (Wayland)";
+      }
+      return "Wayland";
+    }
+    if (session == "x11") {
+      if (!desktop.empty() && !boost::iequals(desktop, "x11")) {
+        return desktop + " (X11)";
+      }
