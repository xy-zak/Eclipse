+  std::vector<display_info_t> display_info(mem_type_e hwdevice_type) {
+    auto names = display_names(hwdevice_type);
+    std::vector<display_info_t> displays;
+    BOOST_LOG(debug) << "Detecting monitors..."sv;
+
+    syncThreadDesktop();
+
+    dxgi::factory1_t factory;
+    HRESULT status = CreateDXGIFactory1(IID_IDXGIFactory1, (void **) &factory);
+    if (FAILED(status)) {
+      for (size_t i = 0; i < names.size(); ++i) {
+        displays.push_back(display_info_t {names[i], 0, 0, i == 0});
+      }
+      return displays;
+    }
+
+    dxgi::adapter_t::pointer adapter_p;
+    for (int x = 0; factory->EnumAdapters1(x, &adapter_p) != DXGI_ERROR_NOT_FOUND; ++x) {
+      dxgi::adapter_t adapter {adapter_p};
+      dxgi::output_t::pointer output_p {};
+      for (int y = 0; adapter->EnumOutputs(y, &output_p) != DXGI_ERROR_NOT_FOUND; ++y) {
+        dxgi::output_t output {output_p};
+        DXGI_OUTPUT_DESC desc;
+        output->GetDesc(&desc);
+        if (!desc.AttachedToDesktop) {
+          continue;
+        }
+        auto device_name = utf_utils::to_utf8(desc.DeviceName);
+        display_info_t info;
+        info.name = device_name;
+        info.width = desc.DesktopCoordinates.right - desc.DesktopCoordinates.left;
+        info.height = desc.DesktopCoordinates.bottom - desc.DesktopCoordinates.top;
+        info.primary = displays.empty();
+        displays.emplace_back(std::move(info));
+      }
+    }
+    return displays;
+  }
