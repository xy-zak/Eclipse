+  std::string eclipse_distro_short(std::string name) {
+    constexpr std::string_view gnu = " GNU/Linux";
+    if (name.size() >= gnu.size() && name.compare(name.size() - gnu.size(), gnu.size(), gnu) == 0) {
+      name.erase(name.size() - gnu.size());
