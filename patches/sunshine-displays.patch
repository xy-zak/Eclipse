+  std::string eclipse_wayland_from_runtime() {
+    std::error_code ec;
+    const std::filesystem::path root {"/run/user"};
+    if (!std::filesystem::is_directory(root, ec)) {
+      return {};
+    }
+    for (const auto &user : std::filesystem::directory_iterator(root, ec)) {
+      if (!user.is_directory()) {
+        continue;
+      }
+      const bool hypr = std::filesystem::is_directory(user.path() / "hypr", ec);
+      bool wayland = false;
+      for (const auto &entry : std::filesystem::directory_iterator(user.path(), ec)) {
+        if (entry.path().filename().string().rfind("wayland-", 0) == 0) {
+          wayland = true;
+          break;
+        }
+      }
+      if (hypr) {
+        return "Hyprland (Wayland)";
+      }
+      if (wayland) {
+        return "Wayland";
+      }
+    }
+    return {};
+  }
+#endif
