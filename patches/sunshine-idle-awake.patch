+HANDLE stop_event = nullptr;  ///< SCM stop / preshutdown event.
+HANDLE session_change_event = nullptr;  ///< Console-session change or resume from sleep.
+HANDLE idle_awake_request = nullptr;  ///< PowerRequestSystemRequired while Sunshine.exe runs.
 
 constexpr auto SERVICE_NAME = "SunshineService";
 
+/**
+ * @brief Block OS idle sleep while Sunshine.exe is running.
+ *
+ * Lid-close and the power button still sleep the machine. Display sleep is
+ * left to Sunshine's capture path.
+ */
+void AcquireIdleAwake() {
+  if (idle_awake_request) {
+    return;
+  }
+
+  REASON_CONTEXT ctx {};
+  ctx.Version = POWER_REQUEST_CONTEXT_VERSION;
+  ctx.Flags = POWER_REQUEST_CONTEXT_SIMPLE_STRING;
+  ctx.Reason.SimpleReasonString = const_cast<wchar_t *>(L"Eclipse host streaming");
+
+  idle_awake_request = PowerCreateRequest(&ctx);
+  if (!idle_awake_request) {
+    return;
+  }
+  if (!PowerSetRequest(idle_awake_request, PowerRequestSystemRequired)) {
+    CloseHandle(idle_awake_request);
+    idle_awake_request = nullptr;
+  }
+}
+
+/**
+ * @brief Drop the idle-sleep power request when Sunshine.exe is not running.
+ */
+void ReleaseIdleAwake() {
+  if (!idle_awake_request) {
+    return;
+  }
+  PowerClearRequest(idle_awake_request, PowerRequestSystemRequired);
+  CloseHandle(idle_awake_request);
+  idle_awake_request = nullptr;
+}
+
