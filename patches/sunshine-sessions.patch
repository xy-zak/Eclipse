+    /**
+     * @brief Return the client address for this session.
+     */
+    std::string peer_address(session_t &session) {
+      std::string raw;
+      if (session.control.peer) {
+        raw = platf::from_sockaddr((sockaddr *) &session.control.peer->address.address);
+      } else if (!session.control.expected_peer_address.empty()) {
+        raw = session.control.expected_peer_address;
+      } else {
+        try {
+          return net::addr_to_normalized_string(session.video.peer.address());
+        } catch (...) {
+          return {};
+        }
+      }
+      try {
+        return net::addr_to_normalized_string(boost::asio::ip::make_address(raw));
+      } catch (...) {
+        return raw;
+      }
+    }
+
