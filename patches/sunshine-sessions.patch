+    /**
+     * @brief Client addresses of active streaming sessions.
+     * @return Deduplicated client IP addresses.
+     */
+    std::vector<std::string> session_addresses() {
+      auto lg = _session_slots.lock();
+      std::set<std::string> uniq;
+      std::vector<std::string> out;
+      for (auto &slot : *_session_slots) {
+        auto state = stream::session::state(*slot);
+        if (state != stream::session::state_e::RUNNING && state != stream::session::state_e::STARTING) {
+          continue;
+        }
+        auto ip = stream::session::peer_address(*slot);
+        if (ip.empty() || !uniq.insert(ip).second) {
+          continue;
+        }
+        out.push_back(std::move(ip));
+      }
+      return out;
+    }
