+SDL_Surface* eclipseRenderStatsCard(const char* text)
+{
+    if (text == nullptr || text[0] == '\0') {
+        return nullptr;
+    }
+    return renderEclipseRowsCard(statsRows(QString::fromUtf8(text)), kGold);
+}
+
+void eclipseToggleShortcutHelp()
+{
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    if (g_helpShown) {
+        hideHintOverlay();
+        return;
+    }
+    if (g_overlayUntil != 0) {
+        hideDisplayMapOverlay();
+    }
+    SDL_Surface* card = renderEclipseRowsCard(shortcutRows(), kGold);
+    if (card == nullptr) {
+        return;
+    }
+    session->getOverlayManager().setOverlaySurface(Overlay::OverlayStatusUpdate, card);
+    g_hintUntil = SDL_GetTicks() + 20000;
+    if (g_hintUntil == 0) {
+        g_hintUntil = 1;
+    }
+    g_helpShown = true;
+}
+
+bool eclipseHandleHelpHotkey(const SDL_KeyboardEvent* event)
+{
+    if (!event || event->state != SDL_PRESSED || event->repeat) {
+        return false;
+    }
+    const Uint16 mod = event->keysym.mod;
+    if (!(mod & KMOD_CTRL) || !(mod & KMOD_LALT) || (mod & (KMOD_GUI | KMOD_MODE))) {
+        return false;
+    }
+    // "?" is Shift+/ on US layouts, so accept / and ? with or without Shift.
+    const bool question = event->keysym.sym == SDLK_SLASH ||
+                          event->keysym.sym == SDLK_QUESTION ||
+                          event->keysym.scancode == SDL_SCANCODE_SLASH;
+    // H is the layout-independent fallback and follows the normal chord.
+    const bool help = event->keysym.sym == SDLK_h && eclipseIsHotkeyChord(event);
+    if (!question && !help) {
+        return false;
+    }
+    eclipseToggleShortcutHelp();
+    return true;
+}
+
+SDL_Surface* eclipseRenderTextCard(const char* text, EclipseCardTone tone, const char* heading)
+{
+    if (text == nullptr || text[0] == '\0') {
+        return nullptr;
+    }
+    CardStyle style;
+    // Stats lines run ~60 columns; keep them on one line each.
+    style.wrapW = 600;
+    style.maxPanelW = 640;
+    style.minPanelW = 0;
+    if (tone == EclipseCardTone::Alert) {
+        style.frame = kFail;
+        style.heading = kFail;
+    }
+    QString body = QString::fromUtf8(text).trimmed();
+    if (heading != nullptr && heading[0] != '\0') {
+        body = QString::fromUtf8(heading) + QLatin1Char('\n') + body;
+    }
+    // Alerts have no separate title: their first line is the headline.
+    style.headingLines = 1;
+    return renderEclipseCard(body, nullptr, false, style);
+}
+
+QString eclipseHotkeyPrefix()
+{
+    return chordPrefix();
+}
+
+QList<EclipseHostDisplay> eclipseHostDisplays()
+{
+    QList<EclipseHostDisplay> out;
+    Session* session = Session::get();
+    if (!session || !session->eclipsePreferences()) {
+        return out;
+    }
+    const QString map = resolveDisplayMap(QString(), session->eclipsePreferences()->eclipseDisplayMap);
+    const int active = session->eclipsePreferences()->hostDisplayIndex;
+    for (const QString& line : displayMapRows(map)) {
+        const QStringList cols = displayMapCols(line.trimmed());
+        if (cols.size() < 3) {
+            continue;
+        }
+        bool ok = false;
+        const int index = cols.at(0).toInt(&ok);
+        if (!ok) {
+            continue;
+        }
+        out.append(EclipseHostDisplay{index, cols.at(1), cols.at(2), index == active});
+    }
+    return out;
+}
+
+void eclipseSwitchDisplay(int displayNumber)
+{
+    char buf[48];
+    snprintf(buf, sizeof(buf), "switch-display %d %u", displayNumber, eclipsePid());
+    eclipseControl(buf, 2000);
+}
+
+bool eclipseAudioEnabled()
+{
+    int value = g_audioEnabled.load();
+    if (value < 0) {
+        int expected = -1;
+        const int next = audioFromEnv() ? 1 : 0;
+        if (g_audioEnabled.compare_exchange_strong(expected, next)) {
+            return next != 0;
+        }
+        return expected != 0;
+    }
+    return value != 0;
+}
+
+void eclipseShowHint(const QString& text, int ms)
+{
+    Session* session = Session::get();
+    if (!session || g_overlayUntil != 0 || qEnvironmentVariableIsEmpty("ECLIPSE_CONTROL")) {
+        return;
+    }
+    SDL_Surface* card = renderEclipseDisplayCard(text, nullptr, false);
+    if (card == nullptr) {
+        return;
+    }
+    session->getOverlayManager().setOverlaySurface(Overlay::OverlayStatusUpdate, card);
+    g_helpShown = false;
+    g_hintUntil = SDL_GetTicks() + static_cast<quint32>(ms);
+    if (g_hintUntil == 0) {
+        g_hintUntil = 1;
+    }
+}
+
+void eclipseHideHint()
+{
+    hideHintOverlay();
+}
+
+void eclipseShowMouseModeHint(bool absolute, bool captured)
+{
+    const QString chord = QString::fromLatin1(hotkeyNeedsShift() ? "Ctrl+Alt+Shift+M" : "Ctrl+Alt+M");
+    if (absolute) {
+        eclipseShowHint(QStringLiteral("DESKTOP MOUSE\n  Pointer follows your cursor.\n  %1 for game mouse.").arg(chord), 2500);
+    }
+    else if (captured) {
+        eclipseShowHint(QStringLiteral("GAME MOUSE\n  Pointer captured for aiming.\n  %1 for desktop mouse.").arg(chord), 2500);
+    }
+    else {
+        eclipseShowHint(QStringLiteral("GAME MOUSE\n  Click the stream to capture the pointer.\n  %1 for desktop mouse.").arg(chord), 6000);
+    }
+}
+
+QString eclipseDisplayName()
+{
+    return qEnvironmentVariable("ECLIPSE_DISPLAY_NAME");
+}
+
+void eclipseStartUiListener()
+{
+    eclipseSetHotkeyShift(hotkeyShiftFromEnv());
+    eclipseStopUiListener();
+    g_listener = new EclipseUiListener();
+    g_listener->start();
+    eclipseStreamUiStart();
+}
+
+void eclipseStopUiListener()
+{
+    eclipseStreamUiStop();
+    g_hintUntil = 0;
+    g_helpShown = false;
+    hideDisplayMapOverlay();
+    if (!g_listener) {
+        return;
+    }
+    g_listener->requestInterruption();
+    g_listener->wait(1000);
+    delete g_listener;
+    g_listener = nullptr;
+}
+
+void eclipsePollDisplayMapOverlay()
+{
+    if (g_overlayUntil != 0 && SDL_TICKS_PASSED(SDL_GetTicks(), g_overlayUntil)) {
+        hideDisplayMapOverlay();
+    }
+    if (g_hintUntil != 0 && SDL_TICKS_PASSED(SDL_GetTicks(), g_hintUntil)) {
+        hideHintOverlay();
+    }
+    eclipseStreamUiPoll();
+}
+
+bool eclipseOverlayHandlesKey(const SDL_KeyboardEvent* event)
+{
+    if (!event || g_overlayUntil == 0 || event->state != SDL_PRESSED || event->repeat) {
+        return false;
+    }
+    switch (event->keysym.sym) {
+    case SDLK_ESCAPE:
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER:
+    case SDLK_SPACE:
+        if (event->keysym.mod & (KMOD_CTRL | KMOD_ALT | KMOD_SHIFT | KMOD_GUI)) {
+            return false;
+        }
+        hideDisplayMapOverlay();
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool eclipseOverlayIsVisible()
+{
+    return g_overlayUntil != 0;
+}
+
+bool eclipseOverlayHandlesMouse(const SDL_MouseButtonEvent* event)
+{
+    if (!event || g_overlayUntil == 0) {
+        return false;
+    }
+    if (event->state == SDL_PRESSED && event->button == SDL_BUTTON_LEFT) {
+        SDL_Rect panel{};
+        SDL_Rect ok{};
+        if (!overlayWindowRects(&panel, &ok) ||
+            overlayPointInRect(event->x, event->y, ok) ||
+            !overlayPointInRect(event->x, event->y, panel)) {
+            hideDisplayMapOverlay();
+        }
+    }
+    return true;
+}
+
+bool eclipseHandleDisplayHotkey(const SDL_KeyboardEvent* event)
+{
+    if (!event || event->state != SDL_PRESSED || event->repeat) {
+        return false;
+    }
+    const bool ctrlAlt = eclipseIsHotkeyChord(event);
+    if (!ctrlAlt) {
+        return false;
+    }
+    // Scancodes too, so AZERTY top-row digits (shifted symbols) still match.
+    if (event->keysym.sym == SDLK_0 || event->keysym.scancode == SDL_SCANCODE_0) {
+        eclipseControl("open-all", 2000);
+        return true;
+    }
+    if (event->keysym.sym == SDLK_MINUS ||
+        event->keysym.sym == SDLK_KP_MINUS ||
+        event->keysym.scancode == SDL_SCANCODE_MINUS) {
+        eclipseRequestShowDisplays();
+        return true;
+    }
+    int digit = 0;
+    if (event->keysym.sym >= SDLK_1 && event->keysym.sym <= SDLK_9) {
+        digit = static_cast<int>(event->keysym.sym - SDLK_0);
+    }
+    else if (event->keysym.scancode >= SDL_SCANCODE_1 && event->keysym.scancode <= SDL_SCANCODE_9) {
+        digit = static_cast<int>(event->keysym.scancode - SDL_SCANCODE_1) + 1;
+    }
+    if (digit > 0) {
+        char buf[48];
+        snprintf(buf, sizeof(buf), "switch-display %d %u", digit, eclipsePid());
+        eclipseControl(buf, 2000);
+        return true;
+    }
+    return false;
+}
+
+void eclipseRequestShowDisplays()
+{
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    if (g_overlayUntil != 0) {
+        hideDisplayMapOverlay();
+        return;
+    }
+    const QString body = parseShowDisplaysReply(nativeEclipseSend("show-displays", 1500));
+    eclipseShowDisplayMapPopup(session->m_Window,
+                               body,
+                               session->m_Preferences->hostDisplayIndex,
+                               eclipseDisplayName());
+}
+
+void eclipseShowDisplayMapPopup(SDL_Window* window,
+                                const QString& hostList,
+                                int activeIndex,
+                                const QString& activeName)
+{
+    const quint32 now = SDL_GetTicks();
+    if (g_lastPopupTicks != 0 && now - g_lastPopupTicks < 400) {
+        return;
+    }
+    g_lastPopupTicks = now;
+    g_hintUntil = 0;
+    g_helpShown = false;
+
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    if (window == nullptr) {
+        window = session->m_Window;
+    }
+
+    const QString map = resolveDisplayMap(hostList, session->m_Preferences->eclipseDisplayMap);
+    const QString body = buildPopupText(map, activeIndex, activeName);
+    SDL_Rect okRect{};
+    SDL_Surface* card = renderEclipseDisplayCard(body, &okRect);
+    if (card != nullptr) {
+        g_overlayW = card->w;
+        g_overlayH = card->h;
+        g_okRect = okRect;
+        g_overlayWindow = window;
+        session->getOverlayManager().setOverlaySurface(Overlay::OverlayStatusUpdate, card);
+    }
+    else {
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                    "Eclipse display overlay failed to render; using status text");
+        const QByteArray utf8 = body.toUtf8();
+        session->getOverlayManager().updateOverlayText(Overlay::OverlayStatusUpdate, utf8.constData());
+        session->getOverlayManager().setOverlayState(Overlay::OverlayStatusUpdate, true);
+        g_overlayW = 0;
+        g_overlayH = 0;
+        g_okRect = {};
+        g_overlayWindow = window;
+    }
+    g_overlayUntil = now + kOverlayMs;
+}
diff --git a/app/streaming/eclipsepopup.h b/app/streaming/eclipsepopup.h
new file mode 100644
index 00000000..14f557d0
--- /dev/null
+++ b/app/streaming/eclipsepopup.h
@@ -0,0 +1,200 @@
+#pragma once
+
+#include "SDL_compat.h"
+
+#include <QByteArray>
+#include <QList>
+#include <QString>
+
+#define SDL_CODE_ECLIPSE_DISPLAY_MAP 106
+
+/**
+ * @brief Start a localhost listener so Eclipse can open this window's display map.
+ */
+void eclipseStartUiListener();
+
+/**
+ * @brief Stop the Eclipse UI listener thread.
+ */
+void eclipseStopUiListener();
+
+/**
+ * @brief Send a one-line command to the Eclipse control socket.
+ *
+ * @param command Command without a trailing newline.
+ * @param readyMs How long to wait for a reply.
+ * @return Reply bytes, which may be empty on failure.
+ */
+QByteArray eclipseControl(const char* command, int readyMs = 400);
+
+/**
+ * @brief Whether this key matches the current Eclipse shortcut chord.
+ *
+ * Ctrl+left Alt, or Ctrl+left Alt+Shift when `ECLIPSE_HOTKEY_SHIFT` is set.
+ * Super and AltGr (right Alt / Mode) are never part of the chord.
+ */
+bool eclipseIsHotkeyChord(const SDL_KeyboardEvent* event);
+
+/**
+ * @brief Apply a live shortcut-chord change from Eclipse (`hotkey-shift 0|1`).
+ */
+void eclipseSetHotkeyShift(bool shift);
+
+/**
+ * @brief Card tone for in-stream text overlays.
+ *
+ * Info: gold frame and heading (stats). Alert: the app's fail red (connection
+ * warnings), matching the error dialogs.
+ */
+enum class EclipseCardTone { Info, Alert };
+
+/**
+ * @brief Render overlay text as an Eclipse card (navy, JetBrains Mono).
+ *
+ * Safe to call from the decoder thread. The first line (or @p heading, when
+ * given) is drawn in the tone colour.
+ *
+ * @return ARGB8888 surface owned by the caller, or nullptr if the font is
+ *         unavailable (callers fall back to Moonlight's outlined text).
+ */
+SDL_Surface* eclipseRenderTextCard(const char* text, EclipseCardTone tone, const char* heading);
+
+/**
+ * @brief Render Moonlight's video stats text as a sectioned Eclipse card.
+ *
+ * Splits the `Label: value` lines into Video / Frame rate / Latency /
+ * Dropped frames sections with right-aligned values. Safe on the decoder
+ * thread. Returns nullptr if the font is unavailable.
+ */
+SDL_Surface* eclipseRenderStatsCard(const char* text);
+
+/**
+ * @brief Current shortcut chord prefix, e.g. "Ctrl+Alt+" or "Ctrl+Alt+Shift+".
+ */
+QString eclipseHotkeyPrefix();
+
+/**
+ * @brief One host display from the Eclipse display map.
+ */
+struct EclipseHostDisplay {
+    int index;        ///< 0-based host display index.
+    QString shortcut; ///< e.g. "Ctrl+Alt+1".
+    QString name;     ///< Host output name.
+    bool current;     ///< This window streams it.
+};
+
+/**
+ * @brief Host displays known to this window (`ECLIPSE_DISPLAY_MAP`).
+ */
+QList<EclipseHostDisplay> eclipseHostDisplays();
+
+/**
+ * @brief Retarget this window to host display @p displayNumber (1-based).
+ */
+void eclipseSwitchDisplay(int displayNumber);
+
+/**
+ * @brief Show or hide the in-stream shortcut list card.
+ */
+void eclipseToggleShortcutHelp();
+
+/**
+ * @brief Consume Ctrl+left Alt+? (or / , with or without Shift) and
+ *        Ctrl+Alt+H; toggles the shortcut list.
+ *
+ * @return true when the key should not be sent to the host.
+ */
+bool eclipseHandleHelpHotkey(const SDL_KeyboardEvent* event);
+
+/**
+ * @brief Whether this window plays stream audio.
+ *
+ * `ECLIPSE_AUDIO=0` starts muted (extra display windows); Eclipse can flip it
+ * live with `audio 0|1` when the audio window closes. Unset means on.
+ */
+bool eclipseAudioEnabled();
+
+/**
+ * @brief Show a non-interactive Eclipse hint card for @p ms milliseconds.
+ *
+ * Never replaces a visible display map and never consumes input.
+ */
+void eclipseShowHint(const QString& text, int ms);
+
+/**
+ * @brief Hide the hint card, if one is shown.
+ */
+void eclipseHideHint();
+
+/**
+ * @brief Hint for the current mouse mode (desktop = absolute, game = relative).
+ *
+ * @param captured Whether relative capture is already active.
+ */
+void eclipseShowMouseModeHint(bool absolute, bool captured);
+
+/**
+ * @brief Host display name for this window (`ECLIPSE_DISPLAY_NAME`).
+ */
+QString eclipseDisplayName();
+
+/**
+ * @brief Ask Eclipse for the host display map and show it on this window.
+ */
+void eclipseRequestShowDisplays();
+
+/**
+ * @brief Consume Ctrl+Alt(+Shift)+0 / - / 1–9 (open-all, overlay, switch-display).
+ *
+ * Esc, F, K, M, Q, S, and V stay in the SDL input handler so they can use
+ * `performSpecialKeyCombo`.
+ *
+ * @param event SDL keyboard event.
+ * @return true when the key should not be sent to the host.
+ */
+bool eclipseHandleDisplayHotkey(const SDL_KeyboardEvent* event);
+
+/**
+ * @brief Dismiss the in-stream display map overlay if it is past its timeout.
+ */
+void eclipsePollDisplayMapOverlay();
+
+/**
+ * @brief Consume Esc/Enter/Space while the display map overlay is visible.
+ *
+ * @param event SDL keyboard event.
+ * @return true when the key should not be sent to the host.
+ */
+bool eclipseOverlayHandlesKey(const SDL_KeyboardEvent* event);
+
+/**
+ * @brief Whether the in-stream display map overlay is currently shown.
+ */
+bool eclipseOverlayIsVisible();
+
+/**
+ * @brief Consume mouse clicks on the display map overlay (OK / dismiss).
+ *
+ * @param event SDL mouse button event.
+ * @return true when the click should not be sent to the host.
+ */
+bool eclipseOverlayHandlesMouse(const SDL_MouseButtonEvent* event);
+
+/**
+ * @brief Show the host-display map as an SDL overlay on the stream window.
+ *
+ * A Qt dialog is a second Wayland toplevel and blocks the SDL loop, so
+ * compositors report the stream window as not responding. The overlay is
+ * painted in Eclipse chrome (navy card, gold border, JetBrains Mono) onto
+ * an SDL surface so it stays on the video path.
+ *
+ * @param window Stream window; used for overlay hit-testing.
+ * @param hostList Map rows of `index;shortcut;name`, joined by `|`.
+ *                 Newlines and tabs are still accepted from older payloads.
+ * @param activeIndex 0-based host display index for this window.
+ * @param activeName Host display name for this window.
+ */
+void eclipseShowDisplayMapPopup(SDL_Window* window,
+                                const QString& hostList,
+                                int activeIndex,
+                                const QString& activeName);
