+
+namespace {
+
+const int kOverlayMs = 8000;
+
+std::atomic<int> g_hotkeyShift{-1};
+
+bool hotkeyShiftFromEnv()
+{
+    const QByteArray value = qgetenv("ECLIPSE_HOTKEY_SHIFT");
+    return !value.isEmpty() && value != "0";
+}
+
+void applyHotkeyShift(bool shift)
+{
+    g_hotkeyShift.store(shift ? 1 : 0);
+}
+
+bool hotkeyNeedsShift()
+{
+    int value = g_hotkeyShift.load();
+    if (value < 0) {
+        const int next = hotkeyShiftFromEnv() ? 1 : 0;
+        int expected = -1;
+        if (g_hotkeyShift.compare_exchange_strong(expected, next)) {
+            return next != 0;
+        }
+        return expected != 0;
+    }
+    return value != 0;
+}
+
+// --- Eclipse control socket (`ECLIPSE_CONTROL`) ---
+
+#ifdef Q_OS_WIN32
+using EclipseSocket = SOCKET;
+const EclipseSocket kInvalidSock = INVALID_SOCKET;
+
+void eclipseCloseSock(EclipseSocket fd)
+{
+    closesocket(fd);
+}
+#else
+using EclipseSocket = int;
+const EclipseSocket kInvalidSock = -1;
+
+void eclipseCloseSock(EclipseSocket fd)
+{
+    close(fd);
+}
+#endif
+
+unsigned eclipsePid()
+{
+#ifdef Q_OS_WIN32
+    return static_cast<unsigned>(_getpid());
+#else
+    return static_cast<unsigned>(getpid());
+#endif
+}
+
+QByteArray nativeEclipseSend(const char* command, int readyMs)
+{
+    const QByteArray dest = qgetenv("ECLIPSE_CONTROL");
+    if (dest.isEmpty() || command == nullptr) {
+        return {};
+    }
+    const QList<QByteArray> parts = dest.split(':');
+    if (parts.size() != 2) {
+        return {};
+    }
+    bool ok = false;
+    const quint16 port = parts.at(1).toUShort(&ok);
+    if (!ok || port == 0) {
+        return {};
+    }
+
+    EclipseSocket fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd == kInvalidSock) {
+        return {};
+    }
+
+    const int waitMs = qMax(readyMs, 200);
+#ifdef Q_OS_WIN32
+    DWORD tv = static_cast<DWORD>(waitMs);
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&tv), sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, reinterpret_cast<const char*>(&tv), sizeof(tv));
+#else
+    timeval tv;
+    tv.tv_sec = waitMs / 1000;
+    tv.tv_usec = (waitMs % 1000) * 1000;
+    if (tv.tv_sec == 0 && tv.tv_usec == 0) {
+        tv.tv_usec = 200000;
+    }
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+#endif
+
+    sockaddr_in addr = {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    const QByteArray host = parts.at(0);
+    if (inet_pton(AF_INET, host.constData(), &addr.sin_addr) != 1) {
+        eclipseCloseSock(fd);
+        return {};
+    }
+    if (::connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+        eclipseCloseSock(fd);
+        return {};
+    }
+
+    QByteArray payload = QByteArray(command) + '\n';
+#ifdef Q_OS_WIN32
+    if (send(fd, payload.constData(), static_cast<int>(payload.size()), 0) < 0) {
+#else
+    if (send(fd, payload.constData(), static_cast<size_t>(payload.size()), 0) < 0) {
+#endif
+        eclipseCloseSock(fd);
+        return {};
+    }
+
+    QByteArray reply;
+    char buf[2048];
+    for (;;) {
+#ifdef Q_OS_WIN32
+        const int n = recv(fd, buf, sizeof(buf), 0);
+#else
+        const ssize_t n = recv(fd, buf, sizeof(buf), 0);
+#endif
+        if (n <= 0) {
+            break;
+        }
+        reply.append(buf, static_cast<int>(n));
+    }
+    eclipseCloseSock(fd);
+    return reply;
+}
+
+// --- Host display map (`index;shortcut;name|...`) ---
+
+QStringList displayMapRows(const QString& hostList)
+{
+    if (hostList.contains(QLatin1Char('|'))) {
+        return hostList.split(QLatin1Char('|'), Qt::SkipEmptyParts);
+    }
+    return hostList.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+}
+
+QStringList displayMapCols(const QString& line)
+{
+    if (line.contains(QLatin1Char('\t'))) {
+        return line.split(QLatin1Char('\t'));
+    }
+    return line.split(QLatin1Char(';'));
+}
+
+bool displayMapHasRows(const QString& hostList)
+{
+    const QStringList lines = displayMapRows(hostList);
+    for (const QString& line : lines) {
+        if (displayMapCols(line.trimmed()).size() >= 3) {
+            return true;
+        }
+    }
+    return false;
+}
+
+QString parseShowDisplaysReply(const QByteArray& reply)
+{
+    QString body = QString::fromUtf8(reply);
+    if (body.startsWith(QLatin1String("ok"))) {
+        const int nl = body.indexOf('\n');
+        return nl >= 0 ? body.mid(nl + 1).trimmed() : QString();
+    }
+    if (body.startsWith(QLatin1String("err"))) {
+        return {};
+    }
+    return body.trimmed();
+}
+
+QString resolveDisplayMap(const QString& hostList, const QString& stored)
+{
+    if (displayMapHasRows(hostList)) {
+        return hostList;
+    }
+    if (displayMapHasRows(stored)) {
+        return stored;
+    }
+    return QString::fromUtf8(qgetenv("ECLIPSE_DISPLAY_MAP"));
+}
+
+QString activeDisplayName(int activeIndex, const QString& activeName)
+{
+    if (!activeName.trimmed().isEmpty()) {
+        return activeName.trimmed();
+    }
+    if (activeIndex >= 0) {
+        return QString("Display %1").arg(activeIndex + 1);
+    }
+    return QStringLiteral("Unknown");
+}
+
+QString buildPopupText(const QString& hostList, int activeIndex, const QString& activeName)
+{
+    QString text;
+    text += QStringLiteral("HOST DISPLAYS\n");
+    const QStringList lines = displayMapRows(hostList);
+    bool any = false;
+    for (const QString& line : lines) {
+        const QStringList cols = displayMapCols(line.trimmed());
+        if (cols.size() < 3) {
+            continue;
+        }
+        any = true;
+        text += QString("  %1    %2\n").arg(cols.at(1), cols.at(2));
+    }
+    if (!any) {
+        text += QStringLiteral("  No host displays reported.\n");
+    }
+    text += QStringLiteral("\nTHIS WINDOW\n  ");
+    text += activeDisplayName(activeIndex, activeName);
+    return text;
+}
+
+// --- Overlay chrome (navy card, gold border, JetBrains Mono) ---
+
+const SDL_Color kNavy{0x0F, 0x0F, 0x29, 0xFF};
+const SDL_Color kGold{0xF7, 0xC7, 0x08, 0xFF};
+const SDL_Color kLavender{0xD9, 0xD9, 0xFC, 0xFF};
+
+SDL_Surface* toArgb8888(SDL_Surface* src)
+{
+    if (src == nullptr) {
+        return nullptr;
+    }
+    if (src->format->format == SDL_PIXELFORMAT_ARGB8888 && !SDL_MUSTLOCK(src)) {
+        return src;
+    }
+    SDL_Surface* converted = SDL_ConvertSurfaceFormat(src, SDL_PIXELFORMAT_ARGB8888, 0);
+    if (converted == nullptr) {
+        return src;
+    }
+    SDL_FreeSurface(src);
+    return converted;
+}
+
+void fillRect(SDL_Surface* dest, const SDL_Rect& rect, SDL_Color color)
+{
+    SDL_Rect clipped = rect;
+    SDL_FillRect(dest, &clipped, SDL_MapRGBA(dest->format, color.r, color.g, color.b, color.a));
+}
+
+TTF_Font* openJetBrainsMono(int pixelSize)
+{
+    static QByteArray fontData;
+    if (fontData.isEmpty()) {
+        QFile file(QStringLiteral(":/res/eclipse/JetBrainsMono-Regular.ttf"));
+        if (file.open(QIODevice::ReadOnly)) {
+            fontData = file.readAll();
+        }
+    }
+    if (fontData.isEmpty() || TTF_WasInit() == 0) {
+        return nullptr;
+    }
+    return TTF_OpenFontRW(SDL_RWFromConstMem(fontData.constData(), fontData.size()), 1, pixelSize);
+}
+
+bool isHeadingLine(const QString& line)
+{
+    const QString trimmed = line.trimmed();
+    return trimmed == QLatin1String("HOST DISPLAYS") ||
+           trimmed == QLatin1String("THIS WINDOW");
+}
+
+SDL_Surface* renderEclipseDisplayCard(const QString& text, SDL_Rect* okOut)
+{
+    const int fontPx = 14;
+    const int padX = 20;
+    const int padTop = 18;
+    const int padBot = 16;
+    const int btnW = 64;
+    const int btnH = 32;
+    const int btnGap = 16;
+    const int wrapW = 480;
+    const int minPanelW = 340;
+    const int maxPanelW = 520;
+
+    TTF_Font* font = openJetBrainsMono(fontPx);
+    if (font == nullptr) {
+        return nullptr;
+    }
+
+    const int lineSkip = TTF_FontLineSkip(font);
+    QList<SDL_Surface*> lines;
+    int textW = 0;
+    int textH = 0;
+    for (const QString& line : text.split(QLatin1Char('\n'))) {
+        if (line.isEmpty()) {
+            lines.append(nullptr);
+            textH += lineSkip;
+            continue;
+        }
+        const SDL_Color color = isHeadingLine(line) ? kGold : kLavender;
+        const QByteArray utf8 = line.toUtf8();
+        SDL_Surface* glyph = toArgb8888(
+            TTF_RenderUTF8_Blended_Wrapped(font, utf8.constData(), color, wrapW));
+        lines.append(glyph);
+        if (glyph != nullptr) {
+            textW = qMax(textW, glyph->w);
+            textH += glyph->h;
+        }
+        else {
+            textH += lineSkip;
+        }
+    }
+
+    const int panelW = qBound(minPanelW, textW + padX * 2, maxPanelW);
+    const int panelH = padTop + textH + btnGap + btnH + padBot;
+    SDL_Surface* card = SDL_CreateRGBSurfaceWithFormat(0, panelW, panelH, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (card == nullptr) {
+        for (SDL_Surface* glyph : lines) {
+            SDL_FreeSurface(glyph);
+        }
+        TTF_CloseFont(font);
+        return nullptr;
+    }
+
+    SDL_SetSurfaceBlendMode(card, SDL_BLENDMODE_NONE);
+    fillRect(card, {0, 0, panelW, panelH}, kGold);
+    fillRect(card, {1, 1, panelW - 2, panelH - 2}, kNavy);
+
+    int y = padTop;
+    for (SDL_Surface* glyph : lines) {
+        if (glyph == nullptr) {
+            y += lineSkip;
+            continue;
+        }
+        SDL_Rect dst{padX, y, glyph->w, glyph->h};
+        SDL_BlitSurface(glyph, nullptr, card, &dst);
+        y += glyph->h;
+        SDL_FreeSurface(glyph);
+    }
+
+    const SDL_Rect okRect{panelW - padX - btnW, panelH - padBot - btnH, btnW, btnH};
+    fillRect(card, okRect, kLavender);
+    SDL_Surface* okGlyph = toArgb8888(TTF_RenderUTF8_Blended(font, "OK", kNavy));
+    if (okGlyph != nullptr) {
+        SDL_Rect okDst{
+            okRect.x + (okRect.w - okGlyph->w) / 2,
+            okRect.y + (okRect.h - okGlyph->h) / 2,
+            okGlyph->w,
+            okGlyph->h};
+        SDL_BlitSurface(okGlyph, nullptr, card, &okDst);
+        SDL_FreeSurface(okGlyph);
+    }
+    TTF_CloseFont(font);
+
+    if (okOut != nullptr) {
+        *okOut = okRect;
+    }
+    return toArgb8888(card);
+}
+
+// --- Overlay lifetime (SDL surface on OverlayStatusUpdate) ---
+
+class EclipseUiListener : public QThread
+{
+public:
+    void run() override
+    {
+        QTcpServer server;
+        if (!server.listen(QHostAddress::LocalHost, 0)) {
+            return;
+        }
+        const quint16 port = server.serverPort();
+        const QByteArray registerCmd =
+            QByteArray("register-ui ") + QByteArray::number(port) + ' ' + QByteArray::number(eclipsePid());
+        nativeEclipseSend(registerCmd.constData(), 400);
+
+        while (!isInterruptionRequested()) {
+            if (!server.waitForNewConnection(250)) {
+                continue;
+            }
+            QTcpSocket* client = server.nextPendingConnection();
+            if (!client) {
+                continue;
+            }
+            client->waitForReadyRead(400);
+            while (client->bytesAvailable() == 0 && client->waitForReadyRead(50)) {
+            }
+            const QByteArray payload = client->readAll();
+            client->disconnectFromHost();
+            delete client;
+            if (payload.isEmpty()) {
+                continue;
+            }
+            const QByteArray trimmed = payload.trimmed();
+            if (trimmed.startsWith("hotkey-shift")) {
+                applyHotkeyShift(trimmed.contains('1'));
+                continue;
+            }
+            SDL_Event event = {};
+            event.type = SDL_USEREVENT;
+            event.user.code = SDL_CODE_ECLIPSE_DISPLAY_MAP;
+            event.user.data1 = SDL_strdup(payload.constData());
+            if (SDL_PushEvent(&event) < 0) {
+                SDL_free(event.user.data1);
+            }
+        }
+    }
+};
+
+EclipseUiListener* g_listener = nullptr;
+quint32 g_overlayUntil = 0;
+quint32 g_lastPopupTicks = 0;
+int g_overlayW = 0;
+int g_overlayH = 0;
+SDL_Rect g_okRect = {};
+SDL_Window* g_overlayWindow = nullptr;
+
+void hideDisplayMapOverlay()
+{
+    g_overlayUntil = 0;
+    g_overlayW = 0;
+    g_overlayH = 0;
+    g_okRect = {};
+    g_overlayWindow = nullptr;
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    session->getOverlayManager().setOverlaySurface(Overlay::OverlayStatusUpdate, nullptr);
+}
+
+bool overlayPointInRect(int x, int y, const SDL_Rect& rect)
+{
+    const SDL_Point point{x, y};
+    return SDL_PointInRect(&point, &rect) == SDL_TRUE;
+}
+
+bool overlayWindowRects(SDL_Rect* panelOut, SDL_Rect* okOut)
+{
+    if (g_overlayWindow == nullptr || g_overlayH <= 0) {
+        return false;
+    }
+    int width = 0;
+    int height = 0;
+    SDL_GetWindowSize(g_overlayWindow, &width, &height);
+    const SDL_Rect panel{0, height - g_overlayH, g_overlayW, g_overlayH};
+    if (panelOut != nullptr) {
+        *panelOut = panel;
+    }
+    if (okOut != nullptr) {
+        *okOut = SDL_Rect{
+            panel.x + g_okRect.x,
+            panel.y + g_okRect.y,
+            g_okRect.w,
+            g_okRect.h};
+    }
+    return true;
+}
+
+} // namespace
+
+QByteArray eclipseControl(const char* command, int readyMs)
+{
+    return nativeEclipseSend(command, readyMs);
+}
+
+bool eclipseIsHotkeyChord(const SDL_KeyboardEvent* event)
+{
+    if (!event) {
+        return false;
+    }
+    const Uint16 mod = event->keysym.mod;
+    if (!(mod & KMOD_CTRL) || !(mod & KMOD_ALT) || (mod & KMOD_GUI)) {
+        return false;
+    }
+    const bool shift = (mod & KMOD_SHIFT) != 0;
+    return shift == hotkeyNeedsShift();
+}
+
+void eclipseSetHotkeyShift(bool shift)
+{
+    applyHotkeyShift(shift);
+}
+
+QString eclipseDisplayName()
+{
+    return qEnvironmentVariable("ECLIPSE_DISPLAY_NAME");
+}
+
+void eclipseStartUiListener()
+{
+    eclipseSetHotkeyShift(hotkeyShiftFromEnv());
+    eclipseStopUiListener();
+    g_listener = new EclipseUiListener();
+    g_listener->start();
+}
+
+void eclipseStopUiListener()
+{
+    hideDisplayMapOverlay();
+    if (!g_listener) {
+        return;
+    }
+    g_listener->requestInterruption();
+    g_listener->wait(1000);
+    delete g_listener;
+    g_listener = nullptr;
+}
+
+void eclipsePollDisplayMapOverlay()
+{
+    if (g_overlayUntil != 0 && SDL_TICKS_PASSED(SDL_GetTicks(), g_overlayUntil)) {
+        hideDisplayMapOverlay();
+    }
+}
+
+bool eclipseOverlayHandlesKey(const SDL_KeyboardEvent* event)
+{
+    if (!event || g_overlayUntil == 0 || event->state != SDL_PRESSED || event->repeat) {
+        return false;
+    }
+    switch (event->keysym.sym) {
+    case SDLK_ESCAPE:
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER:
+    case SDLK_SPACE:
+        if (event->keysym.mod & (KMOD_CTRL | KMOD_ALT | KMOD_SHIFT | KMOD_GUI)) {
+            return false;
+        }
+        hideDisplayMapOverlay();
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool eclipseOverlayIsVisible()
+{
+    return g_overlayUntil != 0;
+}
+
+bool eclipseOverlayHandlesMouse(const SDL_MouseButtonEvent* event)
+{
+    if (!event || g_overlayUntil == 0) {
+        return false;
+    }
+    if (event->state == SDL_PRESSED && event->button == SDL_BUTTON_LEFT) {
+        SDL_Rect panel{};
+        SDL_Rect ok{};
+        if (!overlayWindowRects(&panel, &ok) ||
+            overlayPointInRect(event->x, event->y, ok) ||
+            !overlayPointInRect(event->x, event->y, panel)) {
+            hideDisplayMapOverlay();
+        }
+    }
+    return true;
+}
+
+bool eclipseHandleDisplayHotkey(const SDL_KeyboardEvent* event)
+{
+    if (!event || event->state != SDL_PRESSED || event->repeat) {
+        return false;
+    }
+    const bool ctrlAlt = eclipseIsHotkeyChord(event);
+    if (!ctrlAlt) {
+        return false;
+    }
+    if (event->keysym.sym == SDLK_0) {
+        eclipseControl("open-all", 2000);
+        return true;
+    }
+    if (event->keysym.sym == SDLK_MINUS ||
+        event->keysym.sym == SDLK_KP_MINUS ||
+        event->keysym.scancode == SDL_SCANCODE_MINUS) {
+        eclipseRequestShowDisplays();
+        return true;
+    }
+    if (event->keysym.sym >= SDLK_1 && event->keysym.sym <= SDLK_9) {
+        char buf[48];
+        snprintf(buf, sizeof(buf), "switch-display %d %u",
+                 static_cast<int>(event->keysym.sym - SDLK_0), eclipsePid());
+        eclipseControl(buf, 2000);
+        return true;
+    }
+    return false;
+}
+
+void eclipseRequestShowDisplays()
+{
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    if (g_overlayUntil != 0) {
+        hideDisplayMapOverlay();
+        return;
+    }
+    const QString body = parseShowDisplaysReply(nativeEclipseSend("show-displays", 1500));
+    eclipseShowDisplayMapPopup(session->m_Window,
+                               body,
+                               session->m_Preferences->hostDisplayIndex,
+                               eclipseDisplayName());
+}
+
+void eclipseShowDisplayMapPopup(SDL_Window* window,
+                                const QString& hostList,
+                                int activeIndex,
+                                const QString& activeName)
+{
+    const quint32 now = SDL_GetTicks();
+    if (g_lastPopupTicks != 0 && now - g_lastPopupTicks < 400) {
+        return;
+    }
+    g_lastPopupTicks = now;
+
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    if (window == nullptr) {
+        window = session->m_Window;
+    }
+
+    const QString map = resolveDisplayMap(hostList, session->m_Preferences->eclipseDisplayMap);
+    const QString body = buildPopupText(map, activeIndex, activeName);
+    SDL_Rect okRect{};
+    SDL_Surface* card = renderEclipseDisplayCard(body, &okRect);
+    if (card != nullptr) {
+        g_overlayW = card->w;
+        g_overlayH = card->h;
+        g_okRect = okRect;
+        g_overlayWindow = window;
+        session->getOverlayManager().setOverlaySurface(Overlay::OverlayStatusUpdate, card);
+    }
+    else {
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                    "Eclipse display overlay failed to render; using status text");
+        const QByteArray utf8 = body.toUtf8();
+        session->getOverlayManager().updateOverlayText(Overlay::OverlayStatusUpdate, utf8.constData());
+        session->getOverlayManager().setOverlayState(Overlay::OverlayStatusUpdate, true);
+        g_overlayW = 0;
+        g_overlayH = 0;
+        g_okRect = {};
+        g_overlayWindow = window;
+    }
+    g_overlayUntil = now + kOverlayMs;
+}
