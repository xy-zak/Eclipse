+
+bool eclipseIsHotkeyChord(const SDL_KeyboardEvent* event)
+{
+    if (!event) {
+        return false;
+    }
+    const Uint16 mod = event->keysym.mod;
+    // Left Alt only: Windows reports AltGr as LCtrl+RAlt, and AltGr+Q/0-9/-
+    // types @ { [ ] } \ on DE/FR layouts. Those must reach the host.
+    if (!(mod & KMOD_CTRL) || !(mod & KMOD_LALT) || (mod & (KMOD_GUI | KMOD_MODE))) {
+        return false;
+    }
+    const bool shift = (mod & KMOD_SHIFT) != 0;
+    return shift == hotkeyNeedsShift();
+}
