@@ -0,0 +1,775 @@
+#include "eclipsestreamui.h"
+
+#include "streaming/eclipsepopup.h"
+#include "streaming/session.h"
+
+#include <QColor>
+#include <QFile>
+#include <QImage>
+#include <QList>
+#include <QPainter>
+#include <QSvgRenderer>
+
+#include <SDL_ttf.h>
+
+#include <atomic>
+#include <cmath>
+#include <functional>
+
+namespace {
+
+// App palette (src/index.css), pre-blended where the app uses opacity.
+const SDL_Color kNavy{0x0F, 0x0F, 0x29, 0xFF};
+const SDL_Color kGold{0xF7, 0xC7, 0x08, 0xFF};
+const SDL_Color kLavender{0xD9, 0xD9, 0xFC, 0xFF};
+const SDL_Color kMuted{0x9C, 0x9C, 0xBD, 0xFF};
+const SDL_Color kRule{0x33, 0x33, 0x4F, 0xFF};
+
+const float kDefaultX = 0.97f;
+const float kDefaultY = 0.03f;
+
+std::atomic<int> g_pendingEnabled{-1};
+std::atomic<bool> g_needsRefresh{false};
+
+struct MenuItem {
+    QString label;
+    QString state;
+    QString key;
+    bool checked = false;
+    std::function<void()> run;
+    SDL_Rect rect = {};
+};
+
+struct MenuEntry {
+    enum Kind { Section, Item };
+    Kind kind;
+    QString text;
+    MenuItem item;
+};
+
+struct UiState {
+    bool started = false;
+    bool enabled = false;
+    bool visible = false;
+    bool menuOpen = false;
+
+    float anchorX = kDefaultX;
+    float anchorY = kDefaultY;
+
+    // Last layout, in window pixels (drawable), top-left Y-down.
+    float scale = 1.0f;
+    int viewW = 0;
+    int viewH = 0;
+    SDL_Rect composite = {};
+    SDL_Rect logo = {};
+    SDL_Rect menu = {};
+    QList<MenuEntry> entries;
+    int hover = -1;
+    QString stateKey;
+
+    // Pointer interaction.
+    bool pressOnLogo = false;
+    bool dragging = false;
+    int pressX = 0;
+    int pressY = 0;
+    int pressLogoX = 0;
+    int pressLogoY = 0;
+    int pressedItem = -1;
+    bool swallowUp = false;
+    bool cursorForced = false;
+    int cursorBefore = SDL_ENABLE;
+};
+
+UiState g_ui;
+
+// --- Fonts and glyphs ---
+
+TTF_Font* openFont(const char* resource, int pixelSize)
+{
+    static const QByteArray mono = [] {
+        QFile file(QStringLiteral(":/res/eclipse/JetBrainsMono-Regular.ttf"));
+        return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+    }();
+    static const QByteArray title = [] {
+        QFile file(QStringLiteral(":/res/eclipse/Remboy-Regular.ttf"));
+        return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+    }();
+    const QByteArray& data = (qstrcmp(resource, "title") == 0 && !title.isEmpty()) ? title : mono;
+    if (data.isEmpty() || TTF_WasInit() == 0) {
+        return nullptr;
+    }
+    return TTF_OpenFontRW(SDL_RWFromConstMem(data.constData(), data.size()), 1, pixelSize);
+}
+
+SDL_Surface* glyph(TTF_Font* font, const QString& text, SDL_Color color)
+{
+    if (font == nullptr || text.isEmpty()) {
+        return nullptr;
+    }
+    const QByteArray utf8 = text.toUtf8();
+    SDL_Surface* s = TTF_RenderUTF8_Blended(font, utf8.constData(), color);
+    if (s != nullptr && s->format->format != SDL_PIXELFORMAT_ARGB8888) {
+        SDL_Surface* c = SDL_ConvertSurfaceFormat(s, SDL_PIXELFORMAT_ARGB8888, 0);
+        SDL_FreeSurface(s);
+        s = c;
+    }
+    return s;
+}
+
+void fill(SDL_Surface* dst, SDL_Rect rect, SDL_Color color)
+{
+    SDL_FillRect(dst, &rect, SDL_MapRGBA(dst->format, color.r, color.g, color.b, color.a));
+}
+
+void frame(SDL_Surface* dst, SDL_Rect rect, int border, SDL_Color edge, SDL_Color body)
+{
+    fill(dst, rect, edge);
+    fill(dst, {rect.x + border, rect.y + border, rect.w - 2 * border, rect.h - 2 * border}, body);
+}
+
+void blit(SDL_Surface* src, SDL_Surface* dst, int x, int y)
+{
+    if (src == nullptr) {
+        return;
+    }
+    SDL_Rect r{x, y, src->w, src->h};
+    SDL_BlitSurface(src, nullptr, dst, &r);
+}
+
+// Pixel-art logo (res/eclipse-logo.svg) tinted to @p color.
+SDL_Surface* logoSurface(int size, SDL_Color color)
+{
+    QSvgRenderer svg(QStringLiteral(":/res/eclipse-logo.svg"));
+    if (!svg.isValid() || size <= 0) {
+        return nullptr;
+    }
+    QImage image(size, size, QImage::Format_ARGB32_Premultiplied);
+    image.fill(Qt::transparent);
+    {
+        QPainter painter(&image);
+        svg.render(&painter);
+        painter.setCompositionMode(QPainter::CompositionMode_SourceIn);
+        painter.fillRect(image.rect(), QColor(color.r, color.g, color.b));
+    }
+    image = image.convertToFormat(QImage::Format_ARGB32);
+    SDL_Surface* s = SDL_CreateRGBSurfaceWithFormat(0, size, size, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (s == nullptr) {
+        return nullptr;
+    }
+    for (int row = 0; row < size; row++) {
+        memcpy(static_cast<Uint8*>(s->pixels) + row * s->pitch, image.constScanLine(row), size * 4);
+    }
+    SDL_SetSurfaceBlendMode(s, SDL_BLENDMODE_BLEND);
+    return s;
+}
+
+// --- Window metrics ---
+
+bool viewMetrics(int* pixelW, int* pixelH, float* scale)
+{
+    Session* session = Session::get();
+    SDL_Window* window = session ? session->eclipseWindow() : nullptr;
+    if (window == nullptr) {
+        return false;
+    }
+    int w = 0;
+    int h = 0;
+    SDL_GetWindowSize(window, &w, &h);
+    int pw = w;
+    int ph = h;
+#if SDL_VERSION_ATLEAST(2, 26, 0)
+    SDL_GetWindowSizeInPixels(window, &pw, &ph);
+#endif
+    if (w <= 0 || h <= 0 || pw <= 0 || ph <= 0) {
+        return false;
+    }
+    *pixelW = pw;
+    *pixelH = ph;
+    *scale = SDL_max(1.0f, (float)pw / (float)w);
+    return true;
+}
+
+int px(float v)
+{
+    return (int)std::lround(v * g_ui.scale);
+}
+
+// Event coordinates are in window units; the layout is in drawable pixels.
+void toPixels(int x, int y, int* outX, int* outY)
+{
+    Session* session = Session::get();
+    SDL_Window* window = session ? session->eclipseWindow() : nullptr;
+    int w = 0;
+    int h = 0;
+    if (window != nullptr) {
+        SDL_GetWindowSize(window, &w, &h);
+    }
+    const float sx = w > 0 ? (float)g_ui.viewW / (float)w : 1.0f;
+    const float sy = h > 0 ? (float)g_ui.viewH / (float)h : 1.0f;
+    *outX = (int)(x * sx);
+    *outY = (int)(y * sy);
+}
+
+bool inRect(int x, int y, const SDL_Rect& r)
+{
+    const SDL_Point p{x, y};
+    return SDL_PointInRect(&p, &r) == SDL_TRUE;
+}
+
+// --- Menu model (same actions as the Ctrl+Alt shortcuts) ---
+
+QList<MenuEntry> buildEntries()
+{
+    QList<MenuEntry> entries;
+    Session* session = Session::get();
+    SdlInputHandler* input = session ? session->eclipseInputHandler() : nullptr;
+    SDL_Window* window = session ? session->eclipseWindow() : nullptr;
+    if (session == nullptr || input == nullptr) {
+        return entries;
+    }
+    const QString p = eclipseHotkeyPrefix();
+    const auto section = [&entries](const QString& text) {
+        entries.append(MenuEntry{MenuEntry::Section, text.toUpper(), {}});
+    };
+    const auto item = [&entries](const QString& label, const QString& state, const QString& key,
+                                 std::function<void()> run, bool checked = false) {
+        MenuItem m;
+        m.label = label;
+        m.state = state;
+        m.key = key;
+        m.checked = checked;
+        m.run = std::move(run);
+        entries.append(MenuEntry{MenuEntry::Item, {}, m});
+    };
+
+    const bool fullscreen = window && (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN);
+    const bool stats = session->getOverlayManager().isOverlayEnabled(Overlay::OverlayDebug);
+
+    section(QStringLiteral("Stream"));
+    item(QStringLiteral("Fullscreen"), fullscreen ? QStringLiteral("On") : QStringLiteral("Off"), p + "F",
+         [input] { input->eclipseRunAction(SdlInputHandler::EclipseAction::ToggleFullScreen); });
+    item(QStringLiteral("Close this window"), {}, p + "Q",
+         [input] { input->eclipseRunAction(SdlInputHandler::EclipseAction::Quit); });
+    item(QStringLiteral("Disconnect all windows"), {}, p + "Esc", [input] {
+        eclipseControl("disconnect-all");
+        input->eclipseRunAction(SdlInputHandler::EclipseAction::Quit);
+    });
+
+    section(QStringLiteral("Input"));
+    item(QStringLiteral("Mouse mode"),
+         input->eclipseAbsoluteMouseMode() ? QStringLiteral("Desktop") : QStringLiteral("Game"), p + "M",
+         [input] { input->eclipseRunAction(SdlInputHandler::EclipseAction::ToggleMouseMode); });
+    item(QStringLiteral("System keys go to"),
+         input->isSystemKeyCaptureActive() ? QStringLiteral("Host") : QStringLiteral("This PC"), p + "K",
+         [input] { input->eclipseRunAction(SdlInputHandler::EclipseAction::ToggleSystemKeys); });
+    item(QStringLiteral("Type clipboard on host"), {}, p + "V",
+         [input] { input->eclipseRunAction(SdlInputHandler::EclipseAction::PasteText); });
+
+    const QList<EclipseHostDisplay> displays = eclipseHostDisplays();
+    section(QStringLiteral("Displays"));
+    for (const EclipseHostDisplay& d : displays) {
+        const int n = d.index + 1;
+        item(d.name, d.current ? QStringLiteral("This window") : QString(), d.shortcut,
+             [n] { eclipseSwitchDisplay(n); }, d.current);
+    }
+    item(QStringLiteral("Show host displays"), {}, p + "-", [] { eclipseRequestShowDisplays(); });
+    item(QStringLiteral("One window per display"), {}, p + "0", [] { eclipseControl("open-all", 2000); });
+
+    section(QStringLiteral("Info"));
+    item(QStringLiteral("Connection stats"), stats ? QStringLiteral("On") : QStringLiteral("Off"), p + "S",
+         [input] { input->eclipseRunAction(SdlInputHandler::EclipseAction::ToggleStatsOverlay); });
+    item(QStringLiteral("Shortcut keys"), {}, p + "?", [] { eclipseToggleShortcutHelp(); });
+    return entries;
+}
+
+QString stateKeyFor(const QList<MenuEntry>& entries)
+{
+    QString key;
+    for (const MenuEntry& e : entries) {
+        key += e.text + e.item.label + e.item.state + QLatin1Char('|');
+    }
+    return key;
+}
+
+// --- Rendering ---
+
+void clearOverlay()
+{
+    Session* session = Session::get();
+    if (session) {
+        session->getOverlayManager().setOverlaySurface(Overlay::OverlayEclipseUi, nullptr);
+    }
+}
+
+void render()
+{
+    Session* session = Session::get();
+    if (!session || !g_ui.visible) {
+        clearOverlay();
+        return;
+    }
+    if (!viewMetrics(&g_ui.viewW, &g_ui.viewH, &g_ui.scale)) {
+        return;
+    }
+
+    const int button = px(40);
+    const int border = SDL_max(1, px(1));
+    const int iconSize = px(32);
+    const int freeW = SDL_max(0, g_ui.viewW - button);
+    const int freeH = SDL_max(0, g_ui.viewH - button);
+    int logoX = (int)std::lround(g_ui.anchorX * freeW);
+    int logoY = (int)std::lround(g_ui.anchorY * freeH);
+
+    // Menu layout.
+    TTF_Font* body = nullptr;
+    TTF_Font* small = nullptr;
+    TTF_Font* title = nullptr;
+    QList<SDL_Surface*> owned;
+    struct Row {
+        int entry;
+        SDL_Surface* left;
+        SDL_Surface* state;
+        SDL_Surface* key;
+        SDL_Surface* leftHover;
+        SDL_Surface* stateHover;
+        SDL_Surface* keyHover;
+        int y;
+        int h;
+    };
+    QList<Row> rows;
+    SDL_Surface* titleGlyph = nullptr;
+    SDL_Surface* footGlyph = nullptr;
+    int menuW = 0;
+    int menuH = 0;
+    const int padX = px(16);
+    const int padY = px(14);
+    const int rowPadY = px(5);
+    const int colGap = px(24);
+    const int keyGap = px(14);
+    const int checkW = px(14);
+
+    if (g_ui.menuOpen) {
+        g_ui.entries = buildEntries();
+        g_ui.stateKey = stateKeyFor(g_ui.entries);
+        body = openFont("mono", px(14));
+        small = openFont("mono", px(12));
+        title = openFont("title", px(20));
+        if (body == nullptr || small == nullptr) {
+            g_ui.menuOpen = false;
+        }
+    }
+
+    if (g_ui.menuOpen) {
+        titleGlyph = glyph(title ? title : body, QStringLiteral("Eclipse"), kGold);
+        footGlyph = glyph(small, QStringLiteral("Drag the logo to move it"), kMuted);
+        int y = padY;
+        int leftW = 0;
+        int rightW = 0;
+        if (titleGlyph) {
+            y += titleGlyph->h;
+        }
+        for (int i = 0; i < g_ui.entries.size(); i++) {
+            const MenuEntry& e = g_ui.entries.at(i);
+            Row r{i, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, 0, 0};
+            if (e.kind == MenuEntry::Section) {
+                y += px(i == 0 ? 10 : 14);
+                r.left = glyph(small, e.text, kMuted);
+                r.y = y;
+                r.h = r.left ? r.left->h : px(14);
+                y += r.h + px(4);
+            }
+            else {
+                const QString label = e.item.label;
+                r.left = glyph(body, label, kLavender);
+                r.state = glyph(body, e.item.state, e.item.checked ? kGold : kLavender);
+                r.key = glyph(small, e.item.key, kMuted);
+                r.leftHover = glyph(body, label, kNavy);
+                r.stateHover = glyph(body, e.item.state, kNavy);
+                r.keyHover = glyph(small, e.item.key, kNavy);
+                const int lh = qMax(r.left ? r.left->h : 0, r.state ? r.state->h : 0);
+                r.y = y;
+                r.h = lh + rowPadY * 2;
+                leftW = qMax(leftW, checkW + (r.left ? r.left->w : 0));
+                rightW = qMax(rightW, (r.state ? r.state->w + keyGap : 0) + (r.key ? r.key->w : 0));
+                y += r.h;
+            }
+            rows.append(r);
+        }
+        y += px(10);
+        const int ruleY = y;
+        Q_UNUSED(ruleY);
+        y += 1 + px(10);
+        if (footGlyph) {
+            y += footGlyph->h;
+        }
+        y += padY;
+        menuW = qMax(qMax(titleGlyph ? titleGlyph->w : 0, footGlyph ? footGlyph->w : 0),
+                     leftW + colGap + rightW) + padX * 2;
+        menuW = qMax(menuW, px(300));
+        menuH = y;
+    }
+
+    // Composite: logo plus menu, opening toward the middle of the window.
+    SDL_Rect logoRect{0, 0, button, button};
+    SDL_Rect menuRect{0, 0, menuW, menuH};
+    SDL_Rect comp{logoX, logoY, button, button};
+    if (g_ui.menuOpen) {
+        const int gap = px(6);
+        const bool openLeft = logoX + button / 2 > g_ui.viewW / 2;
+        const bool openUp = logoY + button / 2 > g_ui.viewH / 2;
+        int mx = openLeft ? logoX + button - menuW : logoX;
+        int my = openUp ? logoY - gap - menuH : logoY + button + gap;
+        mx = SDL_clamp(mx, 0, SDL_max(0, g_ui.viewW - menuW));
+        my = SDL_clamp(my, 0, SDL_max(0, g_ui.viewH - menuH));
+        const int x0 = SDL_min(logoX, mx);
+        const int y0 = SDL_min(logoY, my);
+        const int x1 = SDL_max(logoX + button, mx + menuW);
+        const int y1 = SDL_max(logoY + button, my + menuH);
+        comp = {x0, y0, x1 - x0, y1 - y0};
+        menuRect = {mx - x0, my - y0, menuW, menuH};
+    }
+    logoRect.x = logoX - comp.x;
+    logoRect.y = logoY - comp.y;
+
+    SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(0, comp.w, comp.h, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (surface != nullptr) {
+        SDL_SetSurfaceBlendMode(surface, SDL_BLENDMODE_BLEND);
+        // Logo button: navy with gold frame; gold fill while the menu is open.
+        const bool active = g_ui.menuOpen;
+        frame(surface, logoRect, border, kGold, active ? kGold : kNavy);
+        SDL_Surface* icon = logoSurface(iconSize, active ? kNavy : kLavender);
+        blit(icon, surface, logoRect.x + (button - iconSize) / 2, logoRect.y + (button - iconSize) / 2);
+        SDL_FreeSurface(icon);
+
+        if (g_ui.menuOpen) {
+            frame(surface, menuRect, border, kGold, kNavy);
+            const int mx = menuRect.x;
+            const int my = menuRect.y;
+            blit(titleGlyph, surface, mx + padX, my + padY);
+            for (Row& r : rows) {
+                MenuEntry& e = g_ui.entries[r.entry];
+                if (e.kind == MenuEntry::Section) {
+                    blit(r.left, surface, mx + padX, my + r.y);
+                    continue;
+                }
+                SDL_Rect rowRect{mx + border, my + r.y, menuW - border * 2, r.h};
+                const bool hover = r.entry == g_ui.hover;
+                if (hover) {
+                    // Like the app's buttons: hover:bg-sunshine hover:text-eclipse.
+                    fill(surface, rowRect, kGold);
+                }
+                if (e.item.checked) {
+                    fill(surface, {mx + padX, my + r.y + r.h / 2 - px(3), px(6), px(6)}, hover ? kNavy : kGold);
+                }
+                SDL_Surface* left = hover ? r.leftHover : r.left;
+                SDL_Surface* state = hover ? r.stateHover : r.state;
+                SDL_Surface* key = hover ? r.keyHover : r.key;
+                const int textY = my + r.y + rowPadY;
+                blit(left, surface, mx + padX + checkW, textY);
+                int right = mx + menuW - padX;
+                if (key) {
+                    right -= key->w;
+                    blit(key, surface, right, textY + ((left ? left->h : key->h) - key->h) / 2);
+                    right -= keyGap;
+                }
+                if (state) {
+                    blit(state, surface, right - state->w, textY);
+                }
+                // Hit rect relative to the window drawable.
+                e.item.rect = {comp.x + rowRect.x, comp.y + rowRect.y, rowRect.w, rowRect.h};
+            }
+            const int footTop = my + menuH - padY - (footGlyph ? footGlyph->h : 0);
+            fill(surface, {mx + padX, footTop - px(10) - 1, menuW - padX * 2, 1}, kRule);
+            blit(footGlyph, surface, mx + padX, footTop);
+        }
+    }
+
+    for (Row& r : rows) {
+        SDL_FreeSurface(r.left);
+        SDL_FreeSurface(r.state);
+        SDL_FreeSurface(r.key);
+        SDL_FreeSurface(r.leftHover);
+        SDL_FreeSurface(r.stateHover);
+        SDL_FreeSurface(r.keyHover);
+    }
+    SDL_FreeSurface(titleGlyph);
+    SDL_FreeSurface(footGlyph);
+    if (body) {
+        TTF_CloseFont(body);
+    }
+    if (small) {
+        TTF_CloseFont(small);
+    }
+    if (title) {
+        TTF_CloseFont(title);
+    }
+    if (surface == nullptr) {
+        return;
+    }
+
+    g_ui.composite = comp;
+    g_ui.logo = {logoX, logoY, button, button};
+    g_ui.menu = g_ui.menuOpen ? SDL_Rect{comp.x + menuRect.x, comp.y + menuRect.y, menuW, menuH} : SDL_Rect{};
+
+    // Renderers place the overlay from fractions of their own free space.
+    const int cFreeW = g_ui.viewW - comp.w;
+    const int cFreeH = g_ui.viewH - comp.h;
+    Overlay::OverlayManager& om = session->getOverlayManager();
+    om.setOverlayAnchor(Overlay::OverlayEclipseUi,
+                        cFreeW > 0 ? (float)comp.x / cFreeW : 0.0f,
+                        cFreeH > 0 ? (float)comp.y / cFreeH : 0.0f);
+    om.setOverlaySurface(Overlay::OverlayEclipseUi, surface);
+}
+
+void setMenuOpen(bool open)
+{
+    if (g_ui.menuOpen == open) {
+        return;
+    }
+    g_ui.menuOpen = open;
+    g_ui.hover = -1;
+    g_ui.pressedItem = -1;
+    render();
+}
+
+int itemAt(int x, int y)
+{
+    if (!g_ui.menuOpen || !inRect(x, y, g_ui.menu)) {
+        return -1;
+    }
+    for (int i = 0; i < g_ui.entries.size(); i++) {
+        const MenuEntry& e = g_ui.entries.at(i);
+        if (e.kind == MenuEntry::Item && inRect(x, y, e.item.rect)) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+void setCursorForced(bool forced)
+{
+    if (forced == g_ui.cursorForced) {
+        return;
+    }
+    if (forced) {
+        g_ui.cursorBefore = SDL_ShowCursor(SDL_QUERY);
+        SDL_ShowCursor(SDL_ENABLE);
+    }
+    else {
+        SDL_ShowCursor(g_ui.cursorBefore);
+    }
+    g_ui.cursorForced = forced;
+}
+
+bool pointerOverUi(int x, int y)
+{
+    return inRect(x, y, g_ui.logo) || (g_ui.menuOpen && inRect(x, y, g_ui.menu));
+}
+
+bool interactive()
+{
+    // Captured game mouse has no visible pointer; the logo hides meanwhile.
+    return g_ui.visible && !SDL_GetRelativeMouseMode();
+}
+
+void reportPosition()
+{
+    char buf[48];
+    snprintf(buf, sizeof(buf), "ui-pos %.3f %.3f", g_ui.anchorX, g_ui.anchorY);
+    eclipseControl(buf);
+}
+
+} // namespace
+
+void eclipseStreamUiStart()
+{
+    g_ui = UiState{};
+    g_ui.started = true;
+    g_ui.enabled = qgetenv("ECLIPSE_STREAM_UI") == "1";
+    const QList<QByteArray> pos = qgetenv("ECLIPSE_UI_POS").split(',');
+    if (pos.size() == 2) {
+        bool okX = false;
+        bool okY = false;
+        const float x = pos.at(0).toFloat(&okX);
+        const float y = pos.at(1).toFloat(&okY);
+        if (okX && okY) {
+            g_ui.anchorX = SDL_clamp(x, 0.0f, 1.0f);
+            g_ui.anchorY = SDL_clamp(y, 0.0f, 1.0f);
+        }
+    }
+    g_pendingEnabled.store(-1);
+    g_needsRefresh.store(true);
+}
+
+void eclipseStreamUiStop()
+{
+    setCursorForced(false);
+    if (g_ui.visible) {
+        clearOverlay();
+    }
+    g_ui = UiState{};
+}
+
+void eclipseStreamUiNeedsRefresh()
+{
+    g_needsRefresh.store(true);
+}
+
+void eclipseStreamUiSetEnabled(bool enabled)
+{
+    g_pendingEnabled.store(enabled ? 1 : 0);
+}
+
+void eclipseStreamUiPoll()
+{
+    if (!g_ui.started || Session::get() == nullptr) {
+        return;
+    }
+    const int pending = g_pendingEnabled.exchange(-1);
+    if (pending >= 0) {
+        g_ui.enabled = pending != 0;
+        g_needsRefresh.store(true);
+    }
+
+    const bool shouldShow = g_ui.enabled && !SDL_GetRelativeMouseMode();
+    bool refresh = g_needsRefresh.exchange(false);
+    if (shouldShow != g_ui.visible) {
+        g_ui.visible = shouldShow;
+        if (!shouldShow) {
+            g_ui.menuOpen = false;
+            g_ui.dragging = false;
+            g_ui.pressOnLogo = false;
+            setCursorForced(false);
+        }
+        refresh = true;
+    }
+
+    if (g_ui.visible && !refresh) {
+        int w = 0;
+        int h = 0;
+        float scale = 1.0f;
+        if (viewMetrics(&w, &h, &scale) && (w != g_ui.viewW || h != g_ui.viewH)) {
+            refresh = true;
+        }
+        else if (g_ui.menuOpen && stateKeyFor(buildEntries()) != g_ui.stateKey) {
+            // A shortcut changed a toggle while the menu was open.
+            refresh = true;
+        }
+    }
+    if (refresh) {
+        render();
+    }
+}
+
+bool eclipseStreamUiHandleButton(const SDL_MouseButtonEvent* event)
+{
+    if (event == nullptr || event->which == SDL_TOUCH_MOUSEID || !interactive()) {
+        return false;
+    }
+    int x = 0;
+    int y = 0;
+    toPixels(event->x, event->y, &x, &y);
+
+    if (event->state == SDL_PRESSED) {
+        if (inRect(x, y, g_ui.logo)) {
+            if (event->button == SDL_BUTTON_LEFT) {
+                g_ui.pressOnLogo = true;
+                g_ui.dragging = false;
+                g_ui.pressX = x;
+                g_ui.pressY = y;
+                g_ui.pressLogoX = g_ui.logo.x;
+                g_ui.pressLogoY = g_ui.logo.y;
+            }
+            return true;
+        }
+        if (g_ui.menuOpen) {
+            if (inRect(x, y, g_ui.menu)) {
+                g_ui.pressedItem = event->button == SDL_BUTTON_LEFT ? itemAt(x, y) : -1;
+                return true;
+            }
+            // Click outside closes the menu and stays local.
+            setMenuOpen(false);
+            g_ui.swallowUp = true;
+            return true;
+        }
+        return false;
+    }
+
+    // Release.
+    if (g_ui.swallowUp) {
+        g_ui.swallowUp = false;
+        return true;
+    }
+    if (g_ui.pressOnLogo && event->button == SDL_BUTTON_LEFT) {
+        const bool dragged = g_ui.dragging;
+        g_ui.pressOnLogo = false;
+        g_ui.dragging = false;
+        if (dragged) {
+            reportPosition();
+        }
+        else {
+            setMenuOpen(!g_ui.menuOpen);
+        }
+        return true;
+    }
+    if (g_ui.menuOpen && inRect(x, y, g_ui.menu)) {
+        const int item = itemAt(x, y);
+        if (event->button == SDL_BUTTON_LEFT && item >= 0 && item == g_ui.pressedItem) {
+            const std::function<void()> run = g_ui.entries.at(item).item.run;
+            g_ui.pressedItem = -1;
+            setMenuOpen(false);
+            if (run) {
+                run();
+            }
+            g_needsRefresh.store(true);
+        }
+        return true;
+    }
+    return pointerOverUi(x, y);
+}
+
+bool eclipseStreamUiHandleMotion(const SDL_MouseMotionEvent* event)
+{
+    if (event == nullptr || event->which == SDL_TOUCH_MOUSEID || !interactive()) {
+        setCursorForced(false);
+        return false;
+    }
+    int x = 0;
+    int y = 0;
+    toPixels(event->x, event->y, &x, &y);
+
+    if (g_ui.pressOnLogo) {
+        const int dx = x - g_ui.pressX;
+        const int dy = y - g_ui.pressY;
+        if (!g_ui.dragging && (std::abs(dx) > px(4) || std::abs(dy) > px(4))) {
+            g_ui.dragging = true;
+            g_ui.menuOpen = false;
+            g_ui.hover = -1;
+        }
+        if (g_ui.dragging) {
+            const int button = g_ui.logo.w;
+            const int freeW = SDL_max(1, g_ui.viewW - button);
+            const int freeH = SDL_max(1, g_ui.viewH - button);
+            const int lx = SDL_clamp(g_ui.pressLogoX + dx, 0, freeW);
+            const int ly = SDL_clamp(g_ui.pressLogoY + dy, 0, freeH);
+            g_ui.anchorX = (float)lx / freeW;
+            g_ui.anchorY = (float)ly / freeH;
+            render();
+            setCursorForced(true);
+            // The host pointer stays put while the logo moves.
+            return true;
+        }
+    }
+
+    // Show this PC's cursor over the controls (absolute mode hides it).
+    setCursorForced(pointerOverUi(x, y));
+
+    if (g_ui.menuOpen) {
+        const int hover = itemAt(x, y);
+        if (hover != g_ui.hover) {
+            g_ui.hover = hover;
+            render();
+        }
+    }
+    return false;
+}
