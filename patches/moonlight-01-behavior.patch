+// --- Overlay lifetime (SDL surface on OverlayStatusUpdate) ---
+
+class EclipseUiListener : public QThread
+{
+public:
+    void run() override
+    {
+        QTcpServer server;
+        if (!server.listen(QHostAddress::LocalHost, 0)) {
+            return;
+        }
+        const quint16 port = server.serverPort();
+        const QByteArray registerCmd =
+            QByteArray("register-ui ") + QByteArray::number(port) + ' ' + QByteArray::number(eclipsePid());
+        nativeEclipseSend(registerCmd.constData(), 400);
+
+        while (!isInterruptionRequested()) {
+            if (!server.waitForNewConnection(250)) {
+                continue;
+            }
+            QTcpSocket* client = server.nextPendingConnection();
+            if (!client) {
+                continue;
+            }
+            client->waitForReadyRead(400);
+            while (client->bytesAvailable() == 0 && client->waitForReadyRead(50)) {
+            }
+            const QByteArray payload = client->readAll();
+            client->disconnectFromHost();
+            delete client;
+            if (payload.isEmpty()) {
+                continue;
+            }
+            const QByteArray trimmed = payload.trimmed();
+            if (trimmed.startsWith("hotkey-shift")) {
+                applyHotkeyShift(trimmed.contains('1'));
+                continue;
+            }
+            if (trimmed.startsWith("audio ")) {
+                g_audioEnabled.store(trimmed.endsWith('1') ? 1 : 0);
+                continue;
+            }
+            if (trimmed.startsWith("stream-ui ")) {
+                eclipseStreamUiSetEnabled(trimmed.endsWith('1'));
+                continue;
+            }
+            SDL_Event event = {};
+            event.type = SDL_USEREVENT;
+            event.user.code = SDL_CODE_ECLIPSE_DISPLAY_MAP;
+            event.user.data1 = SDL_strdup(payload.constData());
+            if (SDL_PushEvent(&event) < 0) {
+                SDL_free(event.user.data1);
+            }
+        }
+    }
+};
+
+EclipseUiListener* g_listener = nullptr;
