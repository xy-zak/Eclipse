+#pragma once
+
+#include "SDL_compat.h"
+
+/**
+ * @file eclipsestreamui.h
+ * @brief Mouse-assisted stream controls: a draggable Eclipse logo that opens a
+ *        menu of the in-stream shortcut actions.
+ *
+ * Drawn as the `Overlay::OverlayEclipseUi` overlay, so it works in every
+ * renderer and every stream window. Enabled with `ECLIPSE_STREAM_UI=1`;
+ * Eclipse can flip it live with `stream-ui 0|1`. The logo position comes from
+ * `ECLIPSE_UI_POS=fx,fy` (0..1 of the free space) and is reported back with
+ * `ui-pos fx fy` after a drag.
+ */
+
+/**
+ * @brief Read env and show the logo if enabled (SDL main thread).
+ */
+void eclipseStreamUiStart();
+
+/**
+ * @brief Hide the logo and menu (SDL main thread).
+ */
+void eclipseStreamUiStop();
+
+/**
+ * @brief Ask the main loop to push the logo again (renderer reset, resize).
+ *
+ * Thread-safe.
+ */
+void eclipseStreamUiNeedsRefresh();
+
+/**
+ * @brief Turn mouse-assisted controls on or off (from the UI listener thread).
+ *
+ * Thread-safe; applied on the next eclipseStreamUiPoll().
+ */
+void eclipseStreamUiSetEnabled(bool enabled);
+
+/**
+ * @brief Apply pending changes and keep the overlay in sync (SDL main loop).
+ */
+void eclipseStreamUiPoll();
+
+/**
+ * @brief Handle clicks on the logo or menu.
+ *
+ * @return true when the event must not reach the host.
+ */
+bool eclipseStreamUiHandleButton(const SDL_MouseButtonEvent* event);
+
+/**
+ * @brief Track hover and logo drags.
+ *
+ * @return true when the event must not reach the host (while dragging).
+ */
+bool eclipseStreamUiHandleMotion(const SDL_MouseMotionEvent* event);
