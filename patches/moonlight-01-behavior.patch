+
+bool overlayWindowRects(SDL_Rect* panelOut, SDL_Rect* okOut)
+{
+    if (g_overlayWindow == nullptr || g_overlayH <= 0) {
+        return false;
+    }
+    int width = 0;
+    int height = 0;
+    SDL_GetWindowSize(g_overlayWindow, &width, &height);
+    const SDL_Rect panel{0, height - g_overlayH, g_overlayW, g_overlayH};
+    if (panelOut != nullptr) {
+        *panelOut = panel;
+    }
+    if (okOut != nullptr) {
+        *okOut = SDL_Rect{
+            panel.x + g_okRect.x,
+            panel.y + g_okRect.y,
+            g_okRect.w,
+            g_okRect.h};
+    }
+    return true;
+}
