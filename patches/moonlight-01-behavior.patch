+void OverlayManager::setOverlaySurface(OverlayType type, SDL_Surface* surface)
+{
+    m_Overlays[type].enabled = surface != nullptr;
+    if (surface == nullptr) {
+        m_Overlays[type].text[0] = 0;
+    }
+
+    SDL_Surface* oldSurface = (SDL_Surface*)SDL_AtomicSetPtr(
+        (void**)&m_Overlays[type].surface,
+        surface);
+
+    if (m_Renderer != nullptr) {
+        m_Renderer->notifyOverlayUpdated(type);
+    }
+
+    if (oldSurface != nullptr) {
+        SDL_FreeSurface(oldSurface);
+    }
+}
+
+void OverlayManager::setOverlayAnchor(OverlayType type, float fx, float fy)
+{
+    m_Overlays[type].anchorX = SDL_clamp(fx, 0.0f, 1.0f);
+    m_Overlays[type].anchorY = SDL_clamp(fy, 0.0f, 1.0f);
+}
+
+void OverlayManager::getOverlayTopLeft(OverlayType type, int viewportWidth, int viewportHeight,
+                                       int overlayWidth, int overlayHeight, int* x, int* y)
+{
+    const int freeW = SDL_max(0, viewportWidth - overlayWidth);
+    const int freeH = SDL_max(0, viewportHeight - overlayHeight);
+    *x = (int)(m_Overlays[type].anchorX * freeW + 0.5f);
+    *y = (int)(m_Overlays[type].anchorY * freeH + 0.5f);
+}
