+
+namespace {
+
+const int kOverlayMs = 8000;
+
+std::atomic<int> g_hotkeyShift{-1};
+
+bool hotkeyShiftFromEnv()
+{
+    const QByteArray value = qgetenv("ECLIPSE_HOTKEY_SHIFT");
+    return !value.isEmpty() && value != "0";
+}
+
+void applyHotkeyShift(bool shift)
+{
+    g_hotkeyShift.store(shift ? 1 : 0);
+}
+
+// -1 until first read; then 0 (muted) or 1. Unset ECLIPSE_AUDIO keeps audio on.
+std::atomic<int> g_audioEnabled{-1};
+
+bool audioFromEnv()
+{
+    return qgetenv("ECLIPSE_AUDIO") != "0";
+}
+
+bool hotkeyNeedsShift()
+{
+    int value = g_hotkeyShift.load();
+    if (value < 0) {
+        const int next = hotkeyShiftFromEnv() ? 1 : 0;
+        int expected = -1;
+        if (g_hotkeyShift.compare_exchange_strong(expected, next)) {
+            return next != 0;
+        }
+        return expected != 0;
+    }
+    return value != 0;
+}
+
+// --- Eclipse control socket (`ECLIPSE_CONTROL`) ---
+
+#ifdef Q_OS_WIN32
+using EclipseSocket = SOCKET;
+const EclipseSocket kInvalidSock = INVALID_SOCKET;
+
+void eclipseCloseSock(EclipseSocket fd)
+{
+    closesocket(fd);
+}
+#else
+using EclipseSocket = int;
+const EclipseSocket kInvalidSock = -1;
+
+void eclipseCloseSock(EclipseSocket fd)
+{
+    close(fd);
+}
+#endif
+
+unsigned eclipsePid()
+{
+#ifdef Q_OS_WIN32
+    return static_cast<unsigned>(_getpid());
+#else
+    return static_cast<unsigned>(getpid());
+#endif
+}
+
+QByteArray nativeEclipseSend(const char* command, int readyMs)
+{
+    const QByteArray dest = qgetenv("ECLIPSE_CONTROL");
+    if (dest.isEmpty() || command == nullptr) {
+        return {};
+    }
+    const QList<QByteArray> parts = dest.split(':');
+    if (parts.size() != 2) {
+        return {};
+    }
+    bool ok = false;
+    const quint16 port = parts.at(1).toUShort(&ok);
+    if (!ok || port == 0) {
+        return {};
+    }
+
+    EclipseSocket fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd == kInvalidSock) {
+        return {};
+    }
+
+    const int waitMs = qMax(readyMs, 200);
+#ifdef Q_OS_WIN32
+    DWORD tv = static_cast<DWORD>(waitMs);
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&tv), sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, reinterpret_cast<const char*>(&tv), sizeof(tv));
+#else
+    timeval tv;
+    tv.tv_sec = waitMs / 1000;
+    tv.tv_usec = (waitMs % 1000) * 1000;
+    if (tv.tv_sec == 0 && tv.tv_usec == 0) {
+        tv.tv_usec = 200000;
+    }
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+#endif
+
+    sockaddr_in addr = {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    const QByteArray host = parts.at(0);
+    if (inet_pton(AF_INET, host.constData(), &addr.sin_addr) != 1) {
+        eclipseCloseSock(fd);
+        return {};
+    }
+    if (::connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+        eclipseCloseSock(fd);
+        return {};
+    }
+
+    QByteArray payload = QByteArray(command) + '\n';
+#ifdef Q_OS_WIN32
+    if (send(fd, payload.constData(), static_cast<int>(payload.size()), 0) < 0) {
+#else
+    if (send(fd, payload.constData(), static_cast<size_t>(payload.size()), 0) < 0) {
+#endif
+        eclipseCloseSock(fd);
+        return {};
+    }
+
+    QByteArray reply;
+    char buf[2048];
+    for (;;) {
+#ifdef Q_OS_WIN32
+        const int n = recv(fd, buf, sizeof(buf), 0);
+#else
+        const ssize_t n = recv(fd, buf, sizeof(buf), 0);
+#endif
+        if (n <= 0) {
+            break;
+        }
+        reply.append(buf, static_cast<int>(n));
+    }
+    eclipseCloseSock(fd);
+    return reply;
+}
+
+// --- Host display map (`index;shortcut;name|...`) ---
+
+QStringList displayMapRows(const QString& hostList)
+{
+    if (hostList.contains(QLatin1Char('|'))) {
+        return hostList.split(QLatin1Char('|'), Qt::SkipEmptyParts);
+    }
+    return hostList.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+}
+
+QStringList displayMapCols(const QString& line)
+{
+    if (line.contains(QLatin1Char('\t'))) {
+        return line.split(QLatin1Char('\t'));
+    }
+    return line.split(QLatin1Char(';'));
+}
+
+bool displayMapHasRows(const QString& hostList)
+{
+    const QStringList lines = displayMapRows(hostList);
+    for (const QString& line : lines) {
+        if (displayMapCols(line.trimmed()).size() >= 3) {
+            return true;
+        }
+    }
+    return false;
+}
+
+QString parseShowDisplaysReply(const QByteArray& reply)
+{
+    QString body = QString::fromUtf8(reply);
+    if (body.startsWith(QLatin1String("ok"))) {
+        const int nl = body.indexOf('\n');
+        return nl >= 0 ? body.mid(nl + 1).trimmed() : QString();
+    }
+    if (body.startsWith(QLatin1String("err"))) {
+        return {};
+    }
+    return body.trimmed();
+}
+
+QString resolveDisplayMap(const QString& hostList, const QString& stored)
+{
+    if (displayMapHasRows(hostList)) {
+        return hostList;
+    }
+    if (displayMapHasRows(stored)) {
+        return stored;
+    }
+    return QString::fromUtf8(qgetenv("ECLIPSE_DISPLAY_MAP"));
+}
+
+QString activeDisplayName(int activeIndex, const QString& activeName)
+{
+    if (!activeName.trimmed().isEmpty()) {
+        return activeName.trimmed();
+    }
+    if (activeIndex >= 0) {
+        return QString("Display %1").arg(activeIndex + 1);
+    }
+    return QStringLiteral("Unknown");
+}
+
+QString buildPopupText(const QString& hostList, int activeIndex, const QString& activeName)
+{
+    QString text;
+    text += QStringLiteral("HOST DISPLAYS\n");
+    const QStringList lines = displayMapRows(hostList);
+    bool any = false;
+    for (const QString& line : lines) {
+        const QStringList cols = displayMapCols(line.trimmed());
+        if (cols.size() < 3) {
+            continue;
+        }
+        any = true;
+        text += QString("  %1    %2\n").arg(cols.at(1), cols.at(2));
+    }
+    if (!any) {
+        text += QStringLiteral("  No host displays reported.\n");
+    }
+    text += QStringLiteral("\nTHIS WINDOW\n  ");
+    text += activeDisplayName(activeIndex, activeName);
+    return text;
+}
+
+// --- Overlay chrome (navy card, gold border, JetBrains Mono) ---
+
+const SDL_Color kNavy{0x0F, 0x0F, 0x29, 0xFF};
+const SDL_Color kGold{0xF7, 0xC7, 0x08, 0xFF};
+const SDL_Color kLavender{0xD9, 0xD9, 0xFC, 0xFF};
+const SDL_Color kFail{0xF0, 0x52, 0x52, 0xFF};
+// The app's text-moonlight/70 and a faint moonlight rule, pre-blended on navy.
+const SDL_Color kMuted{0x9C, 0x9C, 0xBD, 0xFF};
+const SDL_Color kRule{0x33, 0x33, 0x4F, 0xFF};
+
+SDL_Surface* toArgb8888(SDL_Surface* src)
+{
+    if (src == nullptr) {
+        return nullptr;
+    }
+    if (src->format->format == SDL_PIXELFORMAT_ARGB8888 && !SDL_MUSTLOCK(src)) {
+        return src;
+    }
+    SDL_Surface* converted = SDL_ConvertSurfaceFormat(src, SDL_PIXELFORMAT_ARGB8888, 0);
+    if (converted == nullptr) {
+        return src;
+    }
+    SDL_FreeSurface(src);
+    return converted;
+}
+
+void fillRect(SDL_Surface* dest, const SDL_Rect& rect, SDL_Color color)
+{
+    SDL_Rect clipped = rect;
+    SDL_FillRect(dest, &clipped, SDL_MapRGBA(dest->format, color.r, color.g, color.b, color.a));
+}
+
+TTF_Font* openJetBrainsMono(int pixelSize)
+{
+    // Magic static: stats cards render on the decoder thread, map and hint
+    // cards on the SDL main thread.
+    static const QByteArray fontData = [] {
+        QFile file(QStringLiteral(":/res/eclipse/JetBrainsMono-Regular.ttf"));
+        return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+    }();
+    if (fontData.isEmpty() || TTF_WasInit() == 0) {
+        return nullptr;
+    }
+    return TTF_OpenFontRW(SDL_RWFromConstMem(fontData.constData(), fontData.size()), 1, pixelSize);
+}
+
+bool isHeadingLine(const QString& line)
+{
+    const QString trimmed = line.trimmed();
+    return trimmed == QLatin1String("HOST DISPLAYS") ||
+           trimmed == QLatin1String("THIS WINDOW") ||
+           trimmed == QLatin1String("GAME MOUSE") ||
+           trimmed == QLatin1String("DESKTOP MOUSE");
+}
+
+struct CardStyle {
+    SDL_Color frame = kGold;
+    SDL_Color heading = kGold;
+    // Leading lines drawn in the heading colour (besides isHeadingLine()).
+    int headingLines = 0;
+    int wrapW = 480;
+    int minPanelW = 340;
+    int maxPanelW = 520;
+};
+
+SDL_Surface* renderEclipseCard(const QString& text, SDL_Rect* okOut, bool withOk, const CardStyle& style)
+{
+    const int fontPx = 14;
+    const int padX = 20;
+    const int padTop = 18;
+    const int padBot = 16;
+    const int btnW = 64;
+    const int btnH = 32;
+    const int btnGap = 16;
+    const int wrapW = style.wrapW;
+    const int minPanelW = style.minPanelW;
+    const int maxPanelW = style.maxPanelW;
+
+    TTF_Font* font = openJetBrainsMono(fontPx);
+    if (font == nullptr) {
+        return nullptr;
+    }
+
+    const int lineSkip = TTF_FontLineSkip(font);
+    QList<SDL_Surface*> lines;
+    int textW = 0;
+    int textH = 0;
+    int lineIndex = 0;
+    for (const QString& line : text.split(QLatin1Char('\n'))) {
+        const bool heading = lineIndex++ < style.headingLines || isHeadingLine(line);
+        if (line.isEmpty()) {
+            lines.append(nullptr);
+            textH += lineSkip;
+            continue;
+        }
+        const SDL_Color color = heading ? style.heading : kLavender;
+        const QByteArray utf8 = line.toUtf8();
+        SDL_Surface* glyph = toArgb8888(
+            TTF_RenderUTF8_Blended_Wrapped(font, utf8.constData(), color, wrapW));
+        lines.append(glyph);
+        if (glyph != nullptr) {
+            textW = qMax(textW, glyph->w);
+            textH += glyph->h;
+        }
+        else {
+            textH += lineSkip;
+        }
+    }
+
+    const int panelW = qBound(minPanelW, textW + padX * 2, maxPanelW);
+    const int panelH = padTop + textH + (withOk ? btnGap + btnH : 0) + padBot;
+    SDL_Surface* card = SDL_CreateRGBSurfaceWithFormat(0, panelW, panelH, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (card == nullptr) {
+        for (SDL_Surface* glyph : lines) {
+            SDL_FreeSurface(glyph);
+        }
+        TTF_CloseFont(font);
+        return nullptr;
+    }
+
+    SDL_SetSurfaceBlendMode(card, SDL_BLENDMODE_NONE);
+    fillRect(card, {0, 0, panelW, panelH}, style.frame);
+    fillRect(card, {1, 1, panelW - 2, panelH - 2}, kNavy);
+
+    int y = padTop;
+    for (SDL_Surface* glyph : lines) {
+        if (glyph == nullptr) {
+            y += lineSkip;
+            continue;
+        }
+        SDL_Rect dst{padX, y, glyph->w, glyph->h};
+        SDL_BlitSurface(glyph, nullptr, card, &dst);
+        y += glyph->h;
+        SDL_FreeSurface(glyph);
+    }
+
+    const SDL_Rect okRect = withOk
+        ? SDL_Rect{panelW - padX - btnW, panelH - padBot - btnH, btnW, btnH}
+        : SDL_Rect{};
+    if (withOk) {
+        fillRect(card, okRect, kLavender);
+    }
+    SDL_Surface* okGlyph = withOk ? toArgb8888(TTF_RenderUTF8_Blended(font, "OK", kNavy)) : nullptr;
+    if (okGlyph != nullptr) {
+        SDL_Rect okDst{
+            okRect.x + (okRect.w - okGlyph->w) / 2,
+            okRect.y + (okRect.h - okGlyph->h) / 2,
+            okGlyph->w,
+            okGlyph->h};
+        SDL_BlitSurface(okGlyph, nullptr, card, &okDst);
+        SDL_FreeSurface(okGlyph);
+    }
+    TTF_CloseFont(font);
+
+    if (okOut != nullptr) {
+        *okOut = okRect;
+    }
+    return toArgb8888(card);
+}
+
+SDL_Surface* renderEclipseDisplayCard(const QString& text, SDL_Rect* okOut, bool withOk = true)
+{
+    return renderEclipseCard(text, okOut, withOk, CardStyle{});
+}
+
+// --- Structured cards (title, sections, label/value rows), like the app's popovers ---
+
+struct CardRow {
+    enum Kind { Title, Section, Pair, Note, Rule };
+    Kind kind;
+    QString left;
+    QString right;
+    SDL_Color leftColor = kMuted;
+    SDL_Color rightColor = kLavender;
+};
+
+CardRow titleRow(const QString& text)
+{
+    return CardRow{CardRow::Title, text, {}};
+}
+
+CardRow sectionRow(const QString& text)
+{
+    return CardRow{CardRow::Section, text.toUpper(), {}};
+}
+
+CardRow pairRow(const QString& label, const QString& value)
+{
+    return CardRow{CardRow::Pair, label, value};
+}
+
+CardRow noteRow(const QString& text)
+{
+    return CardRow{CardRow::Note, text, {}};
+}
+
+CardRow ruleRow()
+{
+    return CardRow{CardRow::Rule, {}, {}};
+}
+
+SDL_Surface* renderGlyph(TTF_Font* font, const QString& text, SDL_Color color)
+{
+    if (font == nullptr || text.isEmpty()) {
+        return nullptr;
+    }
+    const QByteArray utf8 = text.toUtf8();
+    return toArgb8888(TTF_RenderUTF8_Blended(font, utf8.constData(), color));
+}
+
+int rowGapBefore(CardRow::Kind kind, int prev)
+{
+    if (prev < 0) {
+        return 0;
+    }
+    if (kind == CardRow::Rule || prev == CardRow::Rule) {
+        return 10;
+    }
+    switch (kind) {
+    case CardRow::Section:
+        return prev == CardRow::Title ? 12 : 16;
+    case CardRow::Pair:
+        return prev == CardRow::Pair ? 5 : (prev == CardRow::Section ? 6 : 10);
+    default:
+        return 8;
+    }
+}
+
+SDL_Surface* renderEclipseRowsCard(const QList<CardRow>& rows, SDL_Color frame)
+{
+    const int padX = 20;
+    const int padTop = 16;
+    const int padBot = 16;
+    const int colGap = 32;
+    const int minPanelW = 300;
+    const int maxPanelW = 760;
+
+    TTF_Font* body = openJetBrainsMono(14);
+    TTF_Font* small = openJetBrainsMono(12);
+    if (body == nullptr || small == nullptr) {
+        if (body != nullptr) {
+            TTF_CloseFont(body);
+        }
+        if (small != nullptr) {
+            TTF_CloseFont(small);
+        }
+        return nullptr;
+    }
+
+    struct Laid {
+        CardRow::Kind kind;
+        SDL_Surface* left;
+        SDL_Surface* right;
+        int y;
+        int h;
+    };
+    QList<Laid> laid;
+    int leftW = 0;
+    int rightW = 0;
+    int fullW = 0;
+    int y = padTop;
+    int prev = -1;
+    for (const CardRow& row : rows) {
+        Laid item{row.kind, nullptr, nullptr, 0, 0};
+        switch (row.kind) {
+        case CardRow::Title:
+            item.left = renderGlyph(body, row.left, frame);
+            break;
+        case CardRow::Section:
+            item.left = renderGlyph(small, row.left, kMuted);
+            break;
+        case CardRow::Note:
+            item.left = renderGlyph(small, row.left, kMuted);
+            break;
+        case CardRow::Pair:
+            item.left = renderGlyph(body, row.left, row.leftColor);
+            item.right = renderGlyph(body, row.right, row.rightColor);
+            break;
+        case CardRow::Rule:
+            break;
+        }
+        y += rowGapBefore(row.kind, prev);
+        item.y = y;
+        if (row.kind == CardRow::Rule) {
+            item.h = 1;
+        }
+        else {
+            const int lh = qMax(item.left ? item.left->h : 0, item.right ? item.right->h : 0);
+            item.h = lh > 0 ? lh : TTF_FontLineSkip(body);
+        }
+        if (row.kind == CardRow::Pair) {
+            leftW = qMax(leftW, item.left ? item.left->w : 0);
+            rightW = qMax(rightW, item.right ? item.right->w : 0);
+        }
+        else if (item.left != nullptr) {
+            fullW = qMax(fullW, item.left->w);
+        }
+        y += item.h;
+        prev = row.kind;
+        laid.append(item);
+    }
+
+    const int contentW = qMax(fullW, leftW + colGap + rightW);
+    const int panelW = qBound(minPanelW, contentW + padX * 2, maxPanelW);
+    const int panelH = y + padBot;
+    SDL_Surface* card = SDL_CreateRGBSurfaceWithFormat(0, panelW, panelH, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (card != nullptr) {
+        SDL_SetSurfaceBlendMode(card, SDL_BLENDMODE_NONE);
+        fillRect(card, {0, 0, panelW, panelH}, frame);
+        fillRect(card, {1, 1, panelW - 2, panelH - 2}, kNavy);
+    }
+    for (const Laid& item : laid) {
+        if (card != nullptr) {
+            if (item.kind == CardRow::Rule) {
+                fillRect(card, {padX, item.y, panelW - padX * 2, 1}, kRule);
+            }
+            if (item.left != nullptr) {
+                SDL_Rect dst{padX, item.y, item.left->w, item.left->h};
+                SDL_BlitSurface(item.left, nullptr, card, &dst);
+            }
+            if (item.right != nullptr) {
+                // Values right-aligned, like the app's <dd class="text-right">.
+                SDL_Rect dst{panelW - padX - item.right->w, item.y, item.right->w, item.right->h};
+                SDL_BlitSurface(item.right, nullptr, card, &dst);
+            }
+        }
+        SDL_FreeSurface(item.left);
+        SDL_FreeSurface(item.right);
+    }
+    TTF_CloseFont(body);
+    TTF_CloseFont(small);
+    return card != nullptr ? toArgb8888(card) : nullptr;
+}
+
+QString chordPrefix()
+{
+    return QString::fromLatin1(hotkeyNeedsShift() ? "Ctrl+Alt+Shift+" : "Ctrl+Alt+");
+}
+
+QString lowerFps(QString value)
+{
+    return value.replace(QStringLiteral(" FPS"), QStringLiteral(" fps"));
+}
+
+// Moonlight's stringifyVideoStats() lines -> sectioned label/value rows.
+QList<CardRow> statsRows(const QString& text)
+{
+    QList<CardRow> video;
+    QList<CardRow> rate;
+    QList<CardRow> latency;
+    QList<CardRow> drops;
+    QList<CardRow> other;
+    static const QRegularExpression streamRe(
+        QStringLiteral("^(\\d+x\\d+) ([\\d.]+) FPS \\(Codec: (.+)\\)$"));
+    static const QRegularExpression hostRe(
+        QStringLiteral("^([\\d.]+)/([\\d.]+)/([\\d.]+) ms$"));
+    static const QRegularExpression varianceRe(
+        QStringLiteral(" \\(variance: ([\\d.]+ ms)\\)"));
+
+    for (const QString& raw : text.split(QLatin1Char('\n'))) {
+        const QString line = raw.trimmed();
+        if (line.isEmpty()) {
+            continue;
+        }
+        const int colon = line.indexOf(QLatin1String(": "));
+        if (colon < 0) {
+            other.append(pairRow(line, {}));
+            continue;
+        }
+        const QString label = line.left(colon);
+        const QString value = line.mid(colon + 2).trimmed();
+
+        if (label == QLatin1String("Video stream")) {
+            const QRegularExpressionMatch m = streamRe.match(value);
+            if (m.hasMatch()) {
+                video.append(pairRow(QStringLiteral("Resolution"), m.captured(1)));
+                video.append(pairRow(QStringLiteral("Frame rate"), m.captured(2) + QStringLiteral(" fps")));
+                video.append(pairRow(QStringLiteral("Codec"), m.captured(3)));
+            }
+            else {
+                video.append(pairRow(QStringLiteral("Stream"), value));
+            }
+        }
+        else if (label.startsWith(QLatin1String("Bitrate"))) {
+            video.append(pairRow(QStringLiteral("Bitrate"), value));
+        }
+        else if (label == QLatin1String("Incoming frame rate from network")) {
+            rate.append(pairRow(QStringLiteral("From network"), lowerFps(value)));
+        }
+        else if (label == QLatin1String("Decoding frame rate")) {
+            rate.append(pairRow(QStringLiteral("Decoded"), lowerFps(value)));
+        }
+        else if (label == QLatin1String("Rendering frame rate")) {
+            rate.append(pairRow(QStringLiteral("Rendered"), lowerFps(value)));
+        }
+        else if (label.startsWith(QLatin1String("Host processing latency"))) {
+            const QRegularExpressionMatch m = hostRe.match(value);
+            latency.append(pairRow(QStringLiteral("Host encode"),
+                                   m.hasMatch()
+                                       ? QStringLiteral("%1 ms  (%2–%3)").arg(m.captured(3), m.captured(1), m.captured(2))
+                                       : value));
+        }
+        else if (label == QLatin1String("Average network latency")) {
+            QString rtt = value;
+            rtt.replace(varianceRe, QStringLiteral("  ± \\1"));
+            latency.append(pairRow(QStringLiteral("Network round trip"), rtt));
+        }
+        else if (label == QLatin1String("Average decoding time")) {
+            latency.append(pairRow(QStringLiteral("Decode"), value));
+        }
+        else if (label == QLatin1String("Average frame queue delay")) {
+            latency.append(pairRow(QStringLiteral("Frame queue"), value));
+        }
+        else if (label.startsWith(QLatin1String("Average rendering time"))) {
+            latency.append(pairRow(QStringLiteral("Render + V-sync"), value));
+        }
+        else if (label == QLatin1String("Frames dropped by your network connection")) {
+            drops.append(pairRow(QStringLiteral("Lost on network"), value));
+        }
+        else if (label == QLatin1String("Frames dropped due to network jitter")) {
+            drops.append(pairRow(QStringLiteral("Network jitter"), value));
+        }
+        else {
+            other.append(pairRow(label, value));
+        }
+    }
+
+    QList<CardRow> rows;
+    rows.append(titleRow(QStringLiteral("CONNECTION STATS")));
+    const auto addSection = [&rows](const QString& name, const QList<CardRow>& section) {
+        if (!section.isEmpty()) {
+            rows.append(sectionRow(name));
+            rows.append(section);
+        }
+    };
+    addSection(QStringLiteral("Video"), video);
+    addSection(QStringLiteral("Frame rate"), rate);
+    addSection(QStringLiteral("Latency"), latency);
+    addSection(QStringLiteral("Dropped frames"), drops);
+    addSection(QStringLiteral("Other"), other);
+    if (rows.size() == 1) {
+        rows.append(noteRow(QStringLiteral("Waiting for video…")));
+    }
+    rows.append(ruleRow());
+    rows.append(noteRow(chordPrefix() + QStringLiteral("S hides these stats")));
+    return rows;
+}
+
+QList<CardRow> shortcutRows()
+{
+    const QString p = chordPrefix();
+    const auto key = [&p](const char* k, const char* action) {
+        // Keys bright and actions muted, like the app's Commands list.
+        CardRow row = pairRow(p + QString::fromUtf8(k), QString::fromUtf8(action));
+        row.leftColor = kLavender;
+        row.rightColor = kMuted;
+        return row;
+    };
+    QList<CardRow> rows;
+    rows.append(titleRow(QStringLiteral("SHORTCUT KEYS")));
+    rows.append(noteRow(QStringLiteral("Hold Ctrl + left Alt%1, then the key. Not sent to the host.")
+                            .arg(hotkeyNeedsShift() ? QStringLiteral(" + Shift") : QString())));
+    rows.append(sectionRow(QStringLiteral("Stream")));
+    rows.append(key("Esc", "Disconnect all windows"));
+    rows.append(key("Q", "Close this window"));
+    rows.append(key("F", "Fullscreen this window"));
+    rows.append(sectionRow(QStringLiteral("Input")));
+    rows.append(key("K", "System keys: this PC or host"));
+    rows.append(key("M", "Mouse: desktop or game"));
+    rows.append(key("V", "Type clipboard on the host"));
+    rows.append(sectionRow(QStringLiteral("Displays")));
+    rows.append(key("-", "List host displays"));
+    rows.append(key("1–9", "This window → host display N"));
+    rows.append(key("0", "One window per host display"));
+    rows.append(sectionRow(QStringLiteral("Info")));
+    rows.append(key("S", "Connection stats"));
+    rows.append(key("?", "This list (also Ctrl+Alt+H)"));
+    rows.append(ruleRow());
+    rows.append(noteRow(QStringLiteral("Press Ctrl+Alt+? again to close.")));
+    return rows;
+}
