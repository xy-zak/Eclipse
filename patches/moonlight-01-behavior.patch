new file mode 100644
index 00000000..ebaf3b85
--- /dev/null
+++ b/app/streaming/eclipsepopup.cpp
@@ -0,0 +1,289 @@
+#include "eclipsepopup.h"
+#include "streaming/session.h"
+
+#include <QEventLoop>
+#include <QFontMetrics>
+#include <QGuiApplication>
+#include <QHostAddress>
+#include <QKeyEvent>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QPen>
+#include <QRasterWindow>
+#include <QTcpServer>
+#include <QTcpSocket>
+#include <QThread>
+
+#ifdef Q_OS_WIN32
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace {
+
+const QColor kBg("#0f0f29");
+const QColor kBorder("#f7c708");
+const QColor kText("#d9d9fc");
+const QColor kOkBg("#d9d9fc");
+const QColor kOkFg("#0f0f29");
+
+QByteArray eclipseSend(const char* command, int readyMs = 400)
+{
+    const QByteArray dest = qgetenv("ECLIPSE_CONTROL");
+    if (dest.isEmpty()) {
+        return {};
+    }
+    const QList<QByteArray> parts = dest.split(':');
+    if (parts.size() != 2) {
+        return {};
+    }
+    bool ok = false;
+    const quint16 port = parts.at(1).toUShort(&ok);
+    if (!ok || port == 0) {
+        return {};
+    }
+    QTcpSocket sock;
+    sock.connectToHost(QString::fromUtf8(parts.at(0)), port);
+    if (!sock.waitForConnected(400)) {
+        return {};
+    }
+    sock.write(QByteArray(command) + '\n');
+    sock.flush();
+    sock.waitForBytesWritten(400);
+    sock.waitForReadyRead(readyMs);
+    const QByteArray reply = sock.readAll();
+    sock.disconnectFromHost();
+    return reply;
+}
+
+QString activeDisplayName(int activeIndex, const QString& activeName)
+{
+    if (!activeName.trimmed().isEmpty()) {
+        return activeName.trimmed();
+    }
+    if (activeIndex >= 0) {
+        return QString("Display %1").arg(activeIndex + 1);
+    }
+    return QStringLiteral("Unknown");
+}
+
+QString buildPopupText(const QString& hostList, int activeIndex, const QString& activeName)
+{
+    QString text;
+    text += QStringLiteral("HOST DISPLAYS\n");
+    const QStringList lines = hostList.split('\n', Qt::SkipEmptyParts);
+    bool any = false;
+    for (const QString& line : lines) {
+        const QStringList cols = line.split('\t');
+        if (cols.size() < 3) {
+            continue;
+        }
+        any = true;
+        text += QString("  %1    %2\n").arg(cols.at(1), cols.at(2));
+    }
+    if (!any) {
+        text += QStringLiteral("  No host displays reported.\n");
+    }
+    text += QStringLiteral("\nTHIS WINDOW\n  ");
+    text += activeDisplayName(activeIndex, activeName);
+    return text;
+}
+
+class EclipseDisplayPopup : public QRasterWindow
+{
+public:
+    EclipseDisplayPopup(const QString& text, SDL_Window* anchor)
+        : m_text(text)
+    {
+        setFlags(Qt::Dialog | Qt::FramelessWindowHint | Qt::WindowStaysOnTopHint);
+        setTitle(QStringLiteral("Host displays"));
+        const QFont font = QGuiApplication::font();
+        const QFontMetrics fm(font);
+        const QRect bounds = fm.boundingRect(QRect(0, 0, 400, 2000), Qt::TextWordWrap, m_text);
+        const int width = qBound(340, bounds.width() + 48, 520);
+        const int height = bounds.height() + 96;
+        resize(width, height);
+        if (anchor) {
+            int x = 0;
+            int y = 0;
+            int w = width;
+            int h = height;
+            SDL_GetWindowPosition(anchor, &x, &y);
+            SDL_GetWindowSize(anchor, &w, &h);
+            setPosition(x + (w - width) / 2, y + (h - height) / 2);
+        }
+        m_ok = QRect(width - 88, height - 44, 64, 28);
+    }
+
+protected:
+    void paintEvent(QPaintEvent*) override
+    {
+        QPainter p(this);
+        const QRect bounds(0, 0, width(), height());
+        p.fillRect(bounds, kBg);
+        p.setPen(QPen(kBorder, 1));
+        p.drawRect(bounds.adjusted(0, 0, -1, -1));
+        p.setPen(kText);
+        p.setFont(QGuiApplication::font());
+        p.drawText(QRect(20, 18, width() - 40, height() - 72), Qt::TextWordWrap, m_text);
+        p.fillRect(m_ok, kOkBg);
+        p.setPen(kOkFg);
+        p.drawText(m_ok, Qt::AlignCenter, QStringLiteral("OK"));
+    }
+
+    void keyPressEvent(QKeyEvent* event) override
+    {
+        switch (event->key()) {
+        case Qt::Key_Escape:
+        case Qt::Key_Return:
+        case Qt::Key_Enter:
+        case Qt::Key_Space:
+            close();
+            break;
+        default:
+            break;
+        }
+    }
+
+    void mouseReleaseEvent(QMouseEvent* event) override
+    {
+        if (m_ok.contains(event->position().toPoint())) {
+            close();
+        }
+    }
+
+private:
+    QString m_text;
+    QRect m_ok;
+};
+
+class EclipseUiListener : public QThread
+{
+public:
+    void run() override
+    {
+        QTcpServer server;
+        if (!server.listen(QHostAddress::LocalHost, 0)) {
+            return;
+        }
+        const quint16 port = server.serverPort();
+#ifdef Q_OS_WIN32
+        const unsigned pid = static_cast<unsigned>(_getpid());
+#else
+        const unsigned pid = static_cast<unsigned>(getpid());
+#endif
+        const QByteArray registerCmd =
+            QByteArray("register-ui ") + QByteArray::number(port) + ' ' + QByteArray::number(pid);
+        eclipseSend(registerCmd.constData());
+
+        while (!isInterruptionRequested()) {
+            if (!server.waitForNewConnection(250)) {
+                continue;
+            }
+            QTcpSocket* client = server.nextPendingConnection();
+            if (!client) {
+                continue;
+            }
+            client->waitForReadyRead(400);
+            while (client->bytesAvailable() == 0 && client->waitForReadyRead(50)) {
+            }
+            const QByteArray payload = client->readAll();
+            client->disconnectFromHost();
+            delete client;
+            if (payload.isEmpty()) {
+                continue;
+            }
+            SDL_Event event = {};
+            event.type = SDL_USEREVENT;
+            event.user.code = SDL_CODE_ECLIPSE_DISPLAY_MAP;
+            event.user.data1 = SDL_strdup(payload.constData());
+            if (SDL_PushEvent(&event) < 0) {
+                SDL_free(event.user.data1);
+            }
+        }
+    }
+};
+
+EclipseUiListener* g_listener = nullptr;
+quint32 g_lastPopupTicks = 0;
+
+} // namespace
+
+void eclipseStartUiListener()
+{
+    eclipseStopUiListener();
+    g_listener = new EclipseUiListener();
+    g_listener->start();
+}
+
+void eclipseStopUiListener()
+{
+    if (!g_listener) {
+        return;
+    }
+    g_listener->requestInterruption();
+    g_listener->wait(1000);
+    delete g_listener;
+    g_listener = nullptr;
+}
+
+void eclipseRequestShowDisplays()
+{
+    Session* session = Session::get();
+    if (!session) {
+        return;
+    }
+    const QByteArray reply = eclipseSend("show-displays", 800);
+    QString body = QString::fromUtf8(reply);
+    if (body.startsWith(QLatin1String("ok"))) {
+        const int nl = body.indexOf('\n');
+        body = nl >= 0 ? body.mid(nl + 1) : QString();
+    }
+    else if (body.startsWith(QLatin1String("err"))) {
+        body.clear();
+    }
+    eclipseShowDisplayMapPopup(session->m_Window,
+                               body.trimmed(),
+                               session->m_Preferences->hostDisplayIndex,
+                               qEnvironmentVariable("ECLIPSE_DISPLAY_NAME"));
+}
+
+void eclipseShowDisplayMapPopup(SDL_Window* window,
+                                const QString& hostList,
+                                int activeIndex,
+                                const QString& activeName)
+{
+    const quint32 now = SDL_GetTicks();
+    if (g_lastPopupTicks != 0 && now - g_lastPopupTicks < 400) {
+        return;
+    }
+    g_lastPopupTicks = now;
+
+    Session* session = Session::get();
+    SdlInputHandler* input = session ? session->m_InputHandler : nullptr;
+    const bool recapture = input && input->isCaptureActive();
+    if (input) {
+        input->raiseAllKeys();
+        input->setCaptureActive(false);
+    }
+
+    const QString text = buildPopupText(hostList, activeIndex, activeName);
+    EclipseDisplayPopup popup(text, window);
+    popup.show();
+    popup.raise();
+    popup.requestActivate();
+    popup.setKeyboardGrabEnabled(true);
+
+    QEventLoop loop;
+    QObject::connect(&popup, &QWindow::visibleChanged, &loop, [&]() {
+        if (!popup.isVisible()) {
+            loop.quit();
+        }
+    });
+    loop.exec();
+
+    if (input && recapture) {
+        input->setCaptureActive(true);
+    }
+}
