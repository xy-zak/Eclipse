+quint32 g_lastPopupTicks = 0;
+int g_overlayW = 0;
+int g_overlayH = 0;
+SDL_Rect g_okRect = {};
+SDL_Window* g_overlayWindow = nullptr;
+// Non-interactive hint card. Shares the OverlayStatusUpdate slot with the
+// display map, which wins: a hint never replaces or clears a visible map.
+quint32 g_hintUntil = 0;
