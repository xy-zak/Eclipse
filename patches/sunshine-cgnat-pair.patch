+  bool is_tailscale_cgnat(const std::string_view &view) {
+    boost::system::error_code ec;
+    auto addr = normalize_address(ip::make_address(std::string {view}, ec));
+    if (ec || !addr.is_v4()) {
+      return false;
+    }
+    const auto cgnat = ip::make_network_v4("100.64.0.0/10"sv);
+    return cgnat.hosts().find(addr.to_v4()) != cgnat.hosts().end();
+  }
+
+  bool is_trusted_pair_peer(const std::string_view &view) {
+    if (from_address(view) == PC) {
+      return true;
+    }
+    return is_tailscale_cgnat(view);
+  }
