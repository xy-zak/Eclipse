+  /**
+   * @brief Return whether this request is a pairing/session API open to the tailnet.
+   * @param request HTTP request whose method and path are inspected.
+   * @return True for POST /api/pin, GET /api/displays, GET /api/sessions, POST /api/apps/close.
+   */
+  bool pairing_api_open_to_mesh(const req_https_t &request) {
+    const auto &method = request->method;
+    auto path = request->path;
+    if (const auto q = path.find('?'); q != std::string::npos) {
+      path.resize(q);
+    }
+    if (!path.empty() && path.back() == '/') {
+      path.pop_back();
+    }
+    return (method == "POST" && path == "/api/pin") ||
+           (method == "GET" && path == "/api/displays") ||
+           (method == "GET" && path == "/api/sessions") ||
+           (method == "POST" && path == "/api/apps/close");
+  }
