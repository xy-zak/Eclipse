diff --git a/app/gui/EclipseSplash.qml b/app/gui/EclipseSplash.qml
new file mode 100644
index 00000000..af32e313
--- /dev/null
+++ b/app/gui/EclipseSplash.qml
@@ -0,0 +1,127 @@
+import QtQuick 2.0
+import QtQuick.Controls 2.2
+
+Item {
+    id: root
+    anchors.fill: parent
+
+    property string hostName: "host"
+    property bool connected: false
+    property string statusOverride: ""
+
+    readonly property color eclipseBg: "#0f0f29"
+    readonly property color moonlight: "#d9d9fc"
+    readonly property color sunshine: "#f7c708"
+    readonly property color success: "#3ecf8e"
+
+    readonly property string statusText: {
+        if (root.statusOverride !== "")
+            return root.statusOverride
+        if (root.connected)
+            return qsTr("Connected to %1").arg(root.hostName)
+        return qsTr("Connecting to %1").arg(root.hostName)
+    }
+
+    FontLoader {
+        id: titleFont
+        source: "qrc:/res/eclipse/Remboy-Regular.ttf"
+    }
+    FontLoader {
+        id: monoFont
+        source: "qrc:/res/eclipse/JetBrainsMono-Regular.ttf"
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: root.eclipseBg
+    }
+
+    Column {
+        anchors.centerIn: parent
+        spacing: 32
+
+        Text {
+            text: "ECLIPSE"
+            color: root.moonlight
+            font.family: titleFont.name !== "" ? titleFont.name : "serif"
+            font.pixelSize: 60
+            font.weight: Font.Normal
+            font.capitalization: Font.AllUppercase
+            anchors.horizontalCenter: parent.horizontalCenter
+        }
+
+        Row {
+            id: connectingRow
+            spacing: 8
+            anchors.horizontalCenter: parent.horizontalCenter
+            visible: root.statusOverride !== "" || !root.connected
+
+            Image {
+                source: "qrc:/res/eclipse/spinner.svg"
+                sourceSize.width: 16
+                sourceSize.height: 16
+                width: 16
+                height: 16
+                smooth: false
+                antialiasing: false
+                asynchronous: false
+                anchors.verticalCenter: parent.verticalCenter
+
+                RotationAnimation on rotation {
+                    running: connectingRow.visible
+                    from: 0
+                    to: 360
+                    duration: 1000
+                    loops: Animation.Infinite
+                }
+            }
+
+            Text {
+                text: root.statusText
+                color: root.moonlight
+                font.family: monoFont.name !== "" ? monoFont.name : "monospace"
+                font.pixelSize: 14
+                anchors.verticalCenter: parent.verticalCenter
+            }
+        }
+
+        Rectangle {
+            id: connectedBox
+            anchors.horizontalCenter: parent.horizontalCenter
+            visible: root.statusOverride === "" && root.connected
+            color: root.success
+            width: connectedRow.implicitWidth + 48
+            height: connectedRow.implicitHeight + 24
+
+            Behavior on color {
+                ColorAnimation { duration: 180 }
+            }
+
+            Row {
+                id: connectedRow
+                spacing: 8
+                anchors.centerIn: parent
+
+                Image {
+                    source: "qrc:/res/eclipse/check-circle.svg"
+                    sourceSize.width: 16
+                    sourceSize.height: 16
+                    width: 16
+                    height: 16
+                    smooth: false
+                    antialiasing: false
+                    asynchronous: false
+                    anchors.verticalCenter: parent.verticalCenter
+                }
+
+                Text {
+                    text: root.statusText
+                    color: root.eclipseBg
+                    font.family: monoFont.name !== "" ? monoFont.name : "monospace"
+                    font.pixelSize: 14
+                    anchors.verticalCenter: parent.verticalCenter
+                }
+            }
+        }
+    }
+}
diff --git a/app/gui/EclipseToast.qml b/app/gui/EclipseToast.qml
new file mode 100644
index 00000000..39f0ead6
--- /dev/null
+++ b/app/gui/EclipseToast.qml
@@ -0,0 +1,41 @@
+import QtQuick 2.0
+
+Item {
+    id: root
+    property alias text: label.text
+    property int timeout: 3000
+    width: box.width
+    height: box.height
+    visible: false
+
+    FontLoader {
+        id: monoFont
+        source: "qrc:/res/eclipse/JetBrainsMono-Regular.ttf"
+    }
+
+    Timer {
+        interval: root.timeout
+        running: root.visible
+        onTriggered: root.visible = false
+    }
+
+    Rectangle {
+        id: box
+        color: "#0f0f29"
+        border.color: "#f7c708"
+        border.width: 1
+        radius: 0
+        width: Math.min(label.implicitWidth + 32, 420)
+        height: label.implicitHeight + 24
+
+        Text {
+            id: label
+            anchors.centerIn: parent
+            width: parent.width - 32
+            wrapMode: Text.Wrap
+            color: "#f7c708"
+            font.family: monoFont.name !== "" ? monoFont.name : "monospace"
+            font.pixelSize: 14
+        }
+    }
+}
