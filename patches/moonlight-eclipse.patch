diff --git c/app/gui/EclipseSplash.qml i/app/gui/EclipseSplash.qml
new file mode 100644
index 00000000..7a1cea84
--- /dev/null
+++ i/app/gui/EclipseSplash.qml
@@ -0,0 +1,73 @@
+import QtQuick 2.0
+import QtQuick.Controls 2.2
+
+Item {
+    id: root
+    anchors.fill: parent
+
+    property string hostName: "host"
+    property bool connected: false
+
+    readonly property color eclipseBg: "#0f0f29"
+    readonly property color moonlight: "#d9d9fc"
+    readonly property color sunshine: "#f7c708"
+    readonly property color success: "#3ecf8e"
+
+    FontLoader {
+        id: archivoFont
+        source: "qrc:/res/eclipse/Archivo-SemiBold.ttf"
+    }
+    FontLoader {
+        id: monoFont
+        source: "qrc:/res/eclipse/JetBrainsMono-Regular.ttf"
+    }
+
+    Column {
+        anchors.centerIn: parent
+        spacing: 36
+
+        Row {
+            spacing: 16
+            anchors.horizontalCenter: parent.horizontalCenter
+
+            Image {
+                source: "qrc:/res/eclipse-logo.svg"
+                sourceSize.width: 48
+                sourceSize.height: 48
+                anchors.verticalCenter: parent.verticalCenter
+            }
+
+            Text {
+                text: "Eclipse Stream"
+                color: root.moonlight
+                font.family: archivoFont.name !== "" ? archivoFont.name : "sans-serif"
+                font.pixelSize: 48
+                font.weight: Font.DemiBold
+                anchors.verticalCenter: parent.verticalCenter
+            }
+        }
+
+        Rectangle {
+            id: statusBox
+            anchors.horizontalCenter: parent.horizontalCenter
+            color: root.connected ? root.success : "transparent"
+            width: statusLabel.implicitWidth + (root.connected ? 48 : 0)
+            height: statusLabel.implicitHeight + (root.connected ? 24 : 0)
+
+            Behavior on color {
+                ColorAnimation { duration: 180 }
+            }
+
+            Text {
+                id: statusLabel
+                anchors.centerIn: parent
+                color: root.connected ? root.eclipseBg : root.moonlight
+                font.family: monoFont.name !== "" ? monoFont.name : "monospace"
+                font.pixelSize: 18
+                text: root.connected
+                      ? qsTr("Connected to %1").arg(root.hostName)
+                      : qsTr("Connecting to %1").arg(root.hostName)
+            }
+        }
+    }
+}
