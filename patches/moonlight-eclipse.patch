 void StreamUtils::scaleSourceToDestinationSurface(SDL_Rect* src, SDL_Rect* dst)
 {
+    if (src->w <= 0 || src->h <= 0 || dst->w <= 0 || dst->h <= 0) {
+        return;
+    }
+
+    // Prefer integer scale so host pixels stay unstretched (letterbox/pillarbox).
+    int integerScale = dst->w / src->w;
+    if (dst->h / src->h < integerScale) {
+        integerScale = dst->h / src->h;
+    }
+    if (integerScale >= 1) {
+        int scaledW = src->w * integerScale;
+        int scaledH = src->h * integerScale;
+        dst->x += (dst->w - scaledW) / 2;
+        dst->y += (dst->h - scaledH) / 2;
+        dst->w = scaledW;
+        dst->h = scaledH;
+        return;
+    }
